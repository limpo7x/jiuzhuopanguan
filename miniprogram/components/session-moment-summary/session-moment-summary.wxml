<view wx:if="{{displayItems.length}}" class="pp-stack">
  <view wx:for="{{displayItems}}" wx:key="key" class="pp-card">
    <view class="pp-row-between">
      <view class="pp-list-copy">
        <text class="pp-item-title">{{item.primaryTitle}}</text>
        <text class="pp-item-meta">{{item.secondaryMeta}}</text>
      </view>
      <text wx:if="{{item.rankingEntryEnabled}}" class="pp-chip pp-chip-active">可推举</text>
    </view>

    <view class="pp-stat-row">
      <view class="pp-stat">
        <text class="pp-stat-value">{{item.canResumeMomentIds.length}}</text>
        <text class="pp-stat-label">可继续</text>
      </view>
    </view>

    <share-task-status
      compact="{{true}}"
      task="{{item.shareTask}}"
      data-index="{{index}}"
      bind:preview="handlePreviewTap"
      bind:retry="handleRetryTap"
    ></share-task-status>

    <view class="pp-action-row">
      <view class="pp-button pp-button-primary" data-index="{{index}}" bindtap="handleBriefTap">看简报</view>
      <view wx:if="{{item.canResume}}" class="pp-button pp-button-secondary" data-index="{{index}}" bindtap="handleResumeTap">继续记录</view>
    </view>
  </view>
</view>

<view wx:elif="{{emptyText}}" class="pp-empty">
  <image class="pp-empty-sticker" src="https://cdn.pomer.cn/static/party-pop-clean/empty-memory-sticker.png" mode="aspectFit"></image>
  <text class="pp-body">{{emptyText}}</text>
</view>
