<view class="pp-panel">
  <view class="pp-row-between">
    <text class="pp-section-title">记录/相册</text>
    <text class="pp-chip">{{nodes.length}} 条</text>
  </view>

  <view wx:if="{{loading}}" class="pp-empty">
    <image class="pp-empty-sticker" src="https://cdn.pomer.cn/static/party-pop-clean/photo-upload-sticker.png" mode="aspectFit"></image>
    <text class="pp-body">同步中...</text>
  </view>

  <view wx:elif="{{nodes.length}}" class="pp-timeline">
    <moment-card
      wx:for="{{nodes}}"
      wx:key="id"
      node="{{item}}"
      compact="{{true}}"
      bind:select="handleSelect"
    ></moment-card>
  </view>

  <view wx:else class="pp-empty">
    <image class="pp-empty-sticker" src="https://cdn.pomer.cn/static/party-pop-clean/empty-memory-sticker.png" mode="aspectFit"></image>
    <text class="pp-body">{{emptyText}}</text>
  </view>
</view>
