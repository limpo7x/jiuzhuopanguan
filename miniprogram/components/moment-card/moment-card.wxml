<view class="pp-timeline-item" data-id="{{node.id}}" data-node-kind="{{node.nodeKind}}" bindtap="handleTap">
  <view class="pp-timeline-axis">
    <text>{{displayTypeText}}</text>
    <view class="pp-timeline-dot"></view>
  </view>
  <view class="pp-timeline-body">
    <view class="pp-list-item">
      <image
        wx:if="{{node.imageUrl && !imageBroken}}"
        class="pp-thumb"
        src="{{node.imageUrl}}"
        mode="aspectFill"
        bindload="handleImageLoad"
        binderror="handleImageError"
      ></image>
      <view wx:else class="pp-thumb">
        <image class="pp-icon-lg" src="https://cdn.pomer.cn/static/party-pop-clean/icons/empty-memory.png" mode="aspectFit"></image>
      </view>
      <view class="pp-list-copy">
        <text class="pp-item-title">{{node.timelineTitle || node.caption || node.targetName || '精彩瞬间'}}</text>
        <text wx:if="{{node.caption}}" class="pp-item-meta">{{node.caption}}</text>
        <text wx:elif="{{node.nodeKind === 'event'}}" class="pp-item-meta">{{node.operatorName}} 记录了 {{node.targetName}}</text>
        <text wx:else class="pp-item-meta">继续记录这段回忆</text>
        <view class="pp-row-between">
          <text class="pp-caption">{{node.uploaderName || node.operatorName || '聚会成员'}}</text>
          <text wx:if="{{displayStatusText}}" class="pp-chip pp-chip-active">{{displayStatusText}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
