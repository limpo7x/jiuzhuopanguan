<view class="pp-nav {{extClass}}">
  <view class="pp-nav-inner" style="{{displayStyle}} {{safeAreaTop}}">
    <view class="pp-nav-left" style="{{leftWidth}}">
      <block wx:if="{{back || homeButton}}">
        <view
          wx:if="{{back}}"
          class="pp-nav-button"
          bindtap="back"
          aria-role="button"
          aria-label="返回"
        >
          <view class="pp-nav-arrow"></view>
        </view>
        <view
          wx:elif="{{homeButton}}"
          class="pp-nav-button"
          bindtap="home"
          aria-role="button"
          aria-label="首页"
        >
          <view class="pp-nav-home-dot"></view>
        </view>
      </block>
      <block wx:else>
        <slot name="left"></slot>
      </block>
    </view>

    <view class="pp-nav-center">
      <view wx:if="{{loading}}" class="pp-loading-dot" aria-role="alert"></view>
      <text wx:if="{{title}}">{{title}}</text>
      <block wx:else>
        <slot name="center"></slot>
      </block>
    </view>

    <view class="pp-nav-right" style="{{rightWidth}}">
      <slot name="right"></slot>
    </view>
  </view>
</view>
