<navigation-bar
  title="聚会简报"
  back="{{true}}"
  customBack="{{true}}"
  bind:back="handleBackTap"
  color="#24160f"
  background="rgba(255,253,248,0.96)"
  ext-class="brief-nav"
></navigation-bar>

<view class="brief-page">
  <scroll-view class="brief-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="brief-hero">
      <view class="brief-tag-row">
        <text class="brief-tag">{{rankingStatusText}}</text>
        <text class="brief-tag brief-tag-soft">{{closingCountText}}</text>
      </view>
      <text class="brief-title">{{briefTitle}}</text>
      <text class="brief-subtitle">{{subtitle}}</text>
      <view class="brief-stat-grid">
        <view wx:for="{{stats}}" wx:key="label" class="brief-stat">
          <text class="brief-stat-value">{{item.value}}</text>
          <text class="brief-stat-label">{{item.label}}</text>
        </view>
      </view>
      <view class="brief-ranking-action" bindtap="handleRankingTap">查看今日回忆榜</view>
    </view>

    <view wx:if="{{loading}}" class="brief-loading">加载中...</view>

    <block wx:else>
      <moment-timeline
        nodes="{{timelineNodes}}"
        loading="{{false}}"
        empty-text="{{timelineEmptyText}}"
        bind:select="handleTimelineSelect"
      ></moment-timeline>
      <view wx:if="{{previewableImageCount}}" class="brief-image-preview-probe" bindtap="handlePreviewFirstImageTap">查看大图</view>

      <view class="brief-section">
        <view class="brief-section-head">
          <text class="brief-section-title">照片推举</text>
          <view class="brief-section-action" bindtap="handleRefreshTap">刷新</view>
        </view>

        <view wx:if="{{nominationItems.length}}" class="brief-nomination-list">
          <view
            wx:for="{{nominationItems}}"
            wx:key="id"
            class="brief-nomination-card {{item.buttonDisabled ? 'brief-nomination-card-disabled' : ''}}"
          >
            <image class="brief-nomination-image" src="{{item.imageUrl}}" mode="aspectFill"></image>
            <view class="brief-nomination-copy">
              <view class="brief-nomination-title-row">
                <text class="brief-nomination-title">{{item.title}}</text>
                <text wx:if="{{item.timeText}}" class="brief-nomination-time">{{item.timeText}}</text>
              </view>
              <text class="brief-nomination-meta">{{item.statusText}}</text>
              <text class="brief-nomination-caption">{{item.caption}}</text>
            </view>
            <view
              class="brief-nomination-action {{item.buttonDisabled ? 'brief-nomination-action-disabled' : ''}}"
              data-moment-id="{{item.id}}"
              catchtap="handleNominatePhotoTap"
            >{{nominationSubmittingMomentId === item.id ? '处理中' : item.buttonLabel}}</view>
          </view>
        </view>

        <view wx:else class="brief-share-empty brief-nomination-empty">
          <text class="brief-share-title">还没有可推举照片</text>
          <text class="brief-share-meta">{{nominationEmptyText}}</text>
        </view>
      </view>
    </block>
  </scroll-view>
</view>
