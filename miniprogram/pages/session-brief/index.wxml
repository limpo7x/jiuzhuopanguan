<navigation-bar title="聚会简报" back="{{true}}" customBack="{{true}}" bind:back="handleBackTap" color="#111317" background="transparent" ext-class="pp-nav-page"></navigation-bar>
<view class="pp-page">
  <image class="pp-stage-bg" src="https://cdn.pomer.cn/static/party-pop-clean/stage-bg-390x844.png" mode="aspectFill"></image>
  <scroll-view class="pp-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="pp-hero pp-panel-lime">
      <text class="pp-kicker">{{subtitle}}</text>
      <text class="pp-title">{{briefTitle || '聚会简报'}}</text>
      <text class="pp-body">{{closingCountText}}</text>
      <view wx:if="{{stats.length}}" class="pp-stat-row" style="margin-top: 14px;">
        <view wx:for="{{stats}}" wx:key="label" class="pp-stat"><text class="pp-stat-value">{{item.value}}</text><text class="pp-stat-label">{{item.label}}</text></view>
      </view>
      <view class="pp-action-row" style="margin-top: 16px;">
        <view class="pp-button pp-button-primary" bindtap="handleSharePosterTap">生成分享图</view>
        <view class="pp-button pp-button-secondary" bindtap="handleRefreshTap"><image class="pp-icon" src="https://cdn.pomer.cn/static/party-pop-clean/icons/action-refresh.png" mode="aspectFit"></image><text>刷新</text></view>
        <view class="pp-button pp-button-ghost" bindtap="handleRankingTap">今日回忆榜</view>
      </view>
    </view>
    <view wx:if="{{loading}}" class="pp-loading"><view class="pp-loading-dot"></view><text>加载中</text></view>
    <view wx:elif="{{errorText}}" class="pp-empty"><text class="pp-section-title">{{errorText}}</text><view class="pp-button pp-button-secondary" bindtap="handleRefreshTap">重试</view></view>
    <view wx:else class="pp-stack">
      <view class="pp-panel">
        <text class="pp-section-title">时间线</text>
        <view wx:if="{{timelineDisplayItems.length}}" class="pp-timeline" style="margin-top: 14px;">
          <view wx:for="{{timelineDisplayItems}}" wx:key="id" class="pp-timeline-item" data-id="{{item.id}}" data-node-kind="{{item.nodeKind}}" bindtap="handleTimelineSelect">
            <view class="pp-row-between">
              <text class="pp-caption">{{item.timeText}}</text>
              <text class="pp-chip pp-chip-active">{{item.actionLabel}}</text>
            </view>
            <image wx:if="{{item.imageUrl}}" class="pp-cover" style="width: 100%; height: 150px; margin-top: 10px;" src="{{item.imageUrl}}" mode="aspectFill"></image>
            <text class="pp-list-title">{{item.title}}</text>
            <text class="pp-body">{{item.detail}}</text>
          </view>
        </view>
        <text wx:else class="pp-body">{{timelineEmptyText}}</text>
      </view>
      <view class="pp-panel">
        <view class="pp-row-between"><text class="pp-section-title">照片推举</text><text class="pp-chip">{{rankingStatusText}}</text></view>
        <view wx:if="{{nominationItems.length}}" class="pp-list" style="margin-top: 14px;">
          <view wx:for="{{nominationItems}}" wx:key="id" class="pp-list-item">
            <image wx:if="{{item.imageUrl}}" class="pp-thumb" style="width: 72px; height: 72px;" src="{{item.imageUrl}}" mode="aspectFill"></image>
            <view class="pp-list-copy"><text class="pp-list-title">{{item.title}}</text><text class="pp-caption">{{item.statusText || item.reason}}</text></view>
            <text class="pp-chip" data-moment-id="{{item.id}}" bindtap="handleNominatePhotoTap">推举</text>
          </view>
        </view>
        <text wx:else class="pp-body">{{nominationEmptyText}}</text>
      </view>
    </view>
  </scroll-view>
  <pp-dialog state="{{__ppDialog}}" toast="{{__ppToast}}" loading="{{__ppLoading}}" bind:confirm="__handlePpDialogConfirm" bind:cancel="__handlePpDialogCancel"></pp-dialog>
</view>
