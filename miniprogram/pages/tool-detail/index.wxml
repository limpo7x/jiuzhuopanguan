<navigation-bar title="{{toolName}}" back="{{true}}" customBack="{{true}}" bind:back="handleBackTap" color="#111317" background="transparent" ext-class="pp-nav-page"></navigation-bar>
<view class="pp-page">
  <image class="pp-stage-bg" src="https://cdn.pomer.cn/static/party-pop-clean/app-bg-party-pop-390x844.png" mode="aspectFill"></image>
  <scroll-view class="pp-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="pp-hero">
      <image wx:if="{{heroImage}}" class="pp-hero-image" src="{{heroImage}}" mode="aspectFill"></image>
      <text class="pp-kicker">TOOL</text>
      <text class="pp-title">{{toolName}}</text>
      <text class="pp-body">{{subtitle || summary}}</text>
    </view>
    <view wx:if="{{toolError}}" class="pp-empty"><text class="pp-section-title">{{toolError}}</text></view>

    <view wx:if="{{toolMode === 'text-count'}}" class="pp-panel"><text class="pp-section-title">文本统计</text><textarea class="pp-textarea" value="{{toolInput}}" placeholder="输入文本" bindinput="handleTextInput"></textarea><view class="pp-grid-2" style="margin-top: 12px;"><view wx:for="{{tips}}" wx:key="label" class="pp-card"><text class="pp-stat-value">{{item.value}}</text><text class="pp-stat-label">{{item.label}}</text></view></view></view>
    <view wx:elif="{{toolMode === 'json'}}" class="pp-panel"><text class="pp-section-title">JSON 工具</text><textarea class="pp-textarea" value="{{toolInput}}" placeholder="粘贴 JSON" bindinput="handleJsonInput"></textarea><view class="pp-action-row" style="margin-top: 12px;"><view class="pp-button pp-button-secondary" bindtap="handleFormatJson">格式化</view><view class="pp-button pp-button-ghost" bindtap="handleMinifyJson">压缩</view><view class="pp-button pp-button-lime" bindtap="handleCopyOutput">复制结果</view></view><text class="pp-body">{{jsonError || toolOutput}}</text></view>
    <view wx:elif="{{toolMode === 'loan'}}" class="pp-panel"><text class="pp-section-title">房贷计算</text><input class="pp-input" data-field="amount" placeholder="贷款总额（万元）" value="{{loanAmount}}" bindinput="handleLoanInput" /><input class="pp-input" data-field="rate" placeholder="年利率（%）" value="{{loanRate}}" bindinput="handleLoanInput" style="margin-top: 10px;" /><input class="pp-input" data-field="years" placeholder="年限" value="{{loanYears}}" bindinput="handleLoanInput" style="margin-top: 10px;" /><view class="pp-grid-2" style="margin-top: 12px;"><view class="pp-card"><text class="pp-stat-value">{{loanMonthly}}</text><text class="pp-stat-label">月供</text></view><view class="pp-card"><text class="pp-stat-value">{{loanTotalPayment}}</text><text class="pp-stat-label">总还款</text></view></view></view>
    <view wx:elif="{{toolMode === 'qr-code'}}" class="pp-panel"><text class="pp-section-title">分享码</text><input class="pp-input" value="{{qrInput}}" placeholder="输入内容" bindinput="handleQrInput" /><view class="pp-button pp-button-primary" style="width: 100%; margin-top: 12px;" bindtap="handleGenerateShareCode">生成分享码</view><text class="pp-code" style="margin-top: 12px;">{{qrCode}}</text><view class="pp-action-row" style="margin-top: 12px;"><view class="pp-button pp-button-ghost" bindtap="handleCopyShareCode">复制分享码</view><view class="pp-button pp-button-secondary" bindtap="handleDownloadQrCode">保存二维码</view></view></view>
    <view wx:elif="{{isImageTool}}" class="pp-panel"><text class="pp-section-title">图片处理</text><view wx:if="{{imagePreviewSrc}}" class="pp-photo" style="height: 220px; margin-top: 12px;"><image src="{{imagePreviewSrc}}" mode="aspectFit" style="width: 100%; height: 100%;"></image><view wx:if="{{toolMode === 'watermark'}}" class="tool-watermark-mask {{watermarkMaskClass}}"></view></view><view wx:else class="pp-empty" bindtap="handleChooseImage"><image class="pp-empty-sticker" src="https://cdn.pomer.cn/static/party-pop-clean/photo-upload-sticker.png" mode="aspectFit"></image><text class="pp-body">先选择图片</text></view><view class="pp-action-row" style="margin-top: 12px;"><view class="pp-button pp-button-secondary" bindtap="handleChooseImage">选择图片</view><view wx:if="{{toolMode === 'nine-grid'}}" class="pp-button pp-button-primary" bindtap="exportNineGridImages">立即处理</view><view wx:elif="{{toolMode === 'watermark'}}" class="pp-button pp-button-primary" bindtap="exportWatermarkImage">立即处理</view><view wx:else class="pp-button pp-button-primary" bindtap="handleRunCompress">立即处理</view></view></view>
    <view wx:else class="pp-panel"><text class="pp-section-title">工具说明</text><text class="pp-body">{{summary}}</text><view class="pp-button pp-button-primary" style="width: 100%; margin-top: 12px;" bindtap="handleSecondaryTap">立即使用</view></view>
  </scroll-view>
  <canvas canvas-id="toolCanvas" class="pp-hidden-canvas" style="width: {{canvasWidth}}px; height: {{canvasHeight}}px;"></canvas>
  <pp-dialog state="{{__ppDialog}}" toast="{{__ppToast}}" loading="{{__ppLoading}}" bind:confirm="__handlePpDialogConfirm" bind:cancel="__handlePpDialogCancel"></pp-dialog>
</view>
