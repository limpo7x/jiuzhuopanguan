<navigation-bar
  title="加入酒局"
  back="{{true}}"
  color="#24160f"
  background="rgba(255,253,248,0.96)"
  ext-class="join-nav"
></navigation-bar>

<view class="join-page">
  <scroll-view class="join-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="join-center">
      <view class="join-goblet-icon"></view>
      <text class="join-title">输入口令加入酒局</text>
      <text class="join-subtitle">{{sessionName}}</text>
    </view>

    <view class="join-field">
      <text class="join-label">酒桌口令</text>
      <input
        class="join-input join-code-input"
        value="{{inviteCode}}"
        maxlength="12"
        placeholder="请输入判官发来的口令"
        placeholder-class="join-placeholder"
        bindinput="handleInviteInput"
      />
    </view>

    <view class="join-field">
      <text class="join-label">当前进度</text>
      <view class="join-input">{{joinedCount}} / {{playerCount}} 已加入</view>
    </view>

    <view class="join-secondary" bindtap="handleLoadByCodeTap">
      <text>{{loading ? '查询中...' : '查询酒局'}}</text>
    </view>

    <view class="join-primary" bindtap="handleJoinTap">
      <text>{{loading ? '处理中...' : '确认加入本局'}}</text>
      <view class="join-primary-icon"></view>
    </view>

    <view class="join-notice">
      <view class="join-notice-icon"></view>
      <text>你可以通过分享链接进入，也可以手动输入判官发来的酒桌口令加入。</text>
    </view>
  </scroll-view>
</view>
