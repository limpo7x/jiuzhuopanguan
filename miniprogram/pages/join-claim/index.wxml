<navigation-bar
  title="加入酒局"
  back="{{true}}"
  color="#24160f"
  background="rgba(255,253,248,0.96)"
  ext-class="join-nav"
></navigation-bar>

<view class="join-page">
  <scroll-view class="join-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="join-center">
      <view class="join-goblet-icon"></view>
      <text class="join-title">朋友邀请你来一局</text>
      <text class="join-subtitle">{{sessionName}}</text>
    </view>

    <view class="join-field">
      <text class="join-label">邀请码</text>
      <view class="join-input">{{inviteCode}}</view>
    </view>

    <view class="join-field">
      <text class="join-label">当前进度</text>
      <view class="join-input">{{joinedCount}} / {{playerCount}} 已加入</view>
    </view>

    <view class="join-primary" bindtap="handleJoinTap">
      <text>{{loading ? '加载中...' : '确认加入本局'}}</text>
      <view class="join-primary-icon"></view>
    </view>

    <view class="join-notice">
      <view class="join-notice-icon"></view>
      <text>首次进入会先校验微信授权，确认你在本局名单内后再放行。</text>
    </view>
  </scroll-view>
</view>
