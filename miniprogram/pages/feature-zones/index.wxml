<navigation-bar title="{{title}}" back="{{true}}" customBack="{{true}}" bind:back="handleBackTap" color="#111317" background="transparent" ext-class="pp-nav-page"></navigation-bar>
<view class="pp-page">
  <image class="pp-stage-bg" src="https://cdn.pomer.cn/static/party-pop-clean/app-bg-party-pop-390x844.png" mode="aspectFill"></image>
  <scroll-view class="pp-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="pp-hero pp-panel-yellow">
      <text class="pp-kicker">FEATURE ZONE</text>
      <text class="pp-title">{{title || '功能区'}}</text>
      <text class="pp-body">{{subtitle || '按后台真实配置展示，不足时说明原因。'}}</text>
    </view>
    <view wx:if="{{loading}}" class="pp-loading"><view class="pp-loading-dot"></view><text>正在读取真实功能配置</text></view>
    <view wx:elif="{{entries.length}}" class="pp-list">
      <view wx:for="{{entries}}" wx:key="id" class="pp-list-item" data-id="{{item.id}}" data-route="{{item.route}}" data-title="{{item.title}}" bindtap="handleEntryTap">
        <view class="pp-avatar"><image class="pp-icon" src="https://cdn.pomer.cn/static/party-pop-clean/icons/service-template.png" mode="aspectFit"></image></view>
        <view class="pp-list-copy"><text class="pp-list-title">{{item.title}}</text><text class="pp-caption">{{item.desc || item.meta || item.reason}}</text></view>
        <text class="pp-chip {{item.disabled ? '' : 'pp-chip-active'}}">{{item.disabled ? '不可用' : '进入'}}</text>
      </view>
    </view>
    <view wx:else class="pp-empty"><text class="pp-section-title">暂无可展示内容</text><text class="pp-body">该功能区等待接口数据或后台配置完成。</text></view>
  </scroll-view>
  <pp-dialog state="{{__ppDialog}}" toast="{{__ppToast}}" loading="{{__ppLoading}}" bind:confirm="__handlePpDialogConfirm" bind:cancel="__handlePpDialogCancel"></pp-dialog>
</view>
