<navigation-bar
  title="{{title}}"
  back="{{true}}"
  customBack="{{true}}"
  bind:back="handleBackTap"
  color="#fff2dd"
  background="rgba(18,16,14,0.88)"
  ext-class="feature-zone-nav"
></navigation-bar>

<view class="feature-zone-page">
  <image class="feature-zone-bg" src="/assets/party-recorder/pr-cs008cn-stage-bg-390x844.svg" mode="aspectFill"></image>
  <scroll-view class="feature-zone-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="feature-zone-hero">
      <text class="feature-zone-kicker">功能区</text>
      <text class="feature-zone-title">{{title}}</text>
      <text class="feature-zone-subtitle">{{subtitle}}</text>
    </view>

    <view wx:if="{{loading}}" class="feature-zone-state">
      <text class="feature-zone-state-title">加载中</text>
      <text class="feature-zone-state-meta">正在读取真实功能配置。</text>
    </view>

    <view wx:elif="{{errorText}}" class="feature-zone-state feature-zone-state-warn">
      <text class="feature-zone-state-title">{{loginRequired ? '需要登录' : '暂不可用'}}</text>
      <text class="feature-zone-state-meta">{{errorText}}</text>
    </view>

    <block wx:else>
      <view wx:if="{{summaryCards.length}}" class="feature-zone-summary">
        <view
          wx:for="{{summaryCards}}"
          wx:key="title"
          class="feature-zone-summary-card {{item.disabled ? 'feature-zone-card-disabled' : ''}}"
        >
          <text class="feature-zone-card-tag">{{item.tag}}</text>
          <text class="feature-zone-card-title">{{item.title}}</text>
          <text class="feature-zone-card-meta">{{item.meta}}</text>
        </view>
      </view>

      <view class="feature-zone-list">
        <block wx:for="{{entries}}" wx:key="title">
          <view
            wx:if="{{item.disabled}}"
            class="feature-zone-row feature-zone-row-disabled"
          >
            <view class="feature-zone-row-copy">
              <text class="feature-zone-row-tag">{{item.tag}}</text>
              <text class="feature-zone-row-title">{{item.title}}</text>
              <text class="feature-zone-row-meta">{{item.meta}}</text>
            </view>
            <text class="feature-zone-row-action">{{item.actionLabel}}</text>
          </view>
          <view
            wx:else
            class="feature-zone-row"
            data-disabled="{{item.disabled}}"
            data-route="{{item.route}}"
            data-title="{{item.title}}"
            bindtap="handleEntryTap"
          >
            <view class="feature-zone-row-copy">
              <text class="feature-zone-row-tag">{{item.tag}}</text>
              <text class="feature-zone-row-title">{{item.title}}</text>
              <text class="feature-zone-row-meta">{{item.meta}}</text>
            </view>
            <text class="feature-zone-row-action">{{item.actionLabel}}</text>
          </view>
        </block>
      </view>

      <view wx:if="{{!entries.length && !summaryCards.length}}" class="feature-zone-state">
        <text class="feature-zone-state-title">暂无可展示内容</text>
        <text class="feature-zone-state-meta">该功能区等待接口数据或后台配置完成。</text>
      </view>
    </block>

    <view class="feature-zone-action feature-zone-action-disabled">
      <text>{{primaryLabel}}</text>
      <text class="feature-zone-action-meta">{{actionHint}}</text>
    </view>
  </scroll-view>
</view>
