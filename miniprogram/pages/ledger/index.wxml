<navigation-bar title="聚会账本" back="{{true}}" customBack="{{true}}" bind:back="handleBackTap" color="#111317" background="transparent" ext-class="pp-nav-page"></navigation-bar>
<view class="pp-page">
  <image class="pp-stage-bg" src="https://cdn.pomer.cn/static/party-pop-clean/stage-bg-390x844.png" mode="aspectFill"></image>
  <scroll-view class="pp-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="pp-hero pp-panel-yellow">
      <text class="pp-kicker">{{sessionViewState}}</text>
      <text class="pp-title">{{sessionName || '聚会账本'}}</text>
      <text class="pp-body">{{sessionHint}}</text>
      <view class="pp-stat-row" style="margin-top: 16px;">
        <view wx:for="{{stats}}" wx:key="label" class="pp-stat"><text class="pp-stat-value">{{item.value}}</text><text class="pp-stat-label">{{item.label}}</text></view>
      </view>
    </view>

    <view wx:if="{{hasSession && players.length}}" class="pp-panel">
      <view class="pp-row-between"><text class="pp-section-title">成员账本</text><text class="pp-chip">{{ledgerEditable ? '可编辑' : '只读'}}</text></view>
      <view class="pp-list" style="margin-top: 14px;">
        <view wx:for="{{players}}" wx:key="id" class="pp-list-item ledger-row">
          <view class="pp-brand ledger-player"><view class="pp-avatar ledger-avatar"><image wx:if="{{item.avatarUrl}}" class="pp-avatar ledger-avatar" src="{{item.avatarUrl}}" mode="aspectFill"></image><text wx:else>员</text></view><text class="pp-list-title ledger-name">{{item.name}}</text></view>
          <view class="ledger-controls">
            <view class="ledger-metric"><text class="ledger-label">欠酒</text><view class="pp-stepper ledger-stepper"><view wx:if="{{ledgerEditable}}" class="pp-stepper-btn ledger-stepper-btn" data-id="{{item.id}}" data-field="debtCount" data-delta="-1" bindtap="handleAdjustTap"><image class="pp-icon ledger-icon" src="https://cdn.pomer.cn/static/party-pop-clean/icons/step-minus.png" mode="aspectFit"></image></view><text class="pp-stepper-value ledger-value">{{item.debtCount}}</text><view wx:if="{{ledgerEditable}}" class="pp-stepper-btn ledger-stepper-btn" data-id="{{item.id}}" data-field="debtCount" data-delta="1" bindtap="handleAdjustTap"><image class="pp-icon ledger-icon" src="https://cdn.pomer.cn/static/party-pop-clean/icons/step-plus.png" mode="aspectFit"></image></view></view></view>
            <view class="ledger-metric"><text class="ledger-label">加酒</text><view class="pp-stepper ledger-stepper"><view wx:if="{{ledgerEditable}}" class="pp-stepper-btn ledger-stepper-btn" data-id="{{item.id}}" data-field="drinkCount" data-delta="-1" bindtap="handleAdjustTap"><image class="pp-icon ledger-icon" src="https://cdn.pomer.cn/static/party-pop-clean/icons/step-minus.png" mode="aspectFit"></image></view><text class="pp-stepper-value ledger-value">{{item.drinkCount}}</text><view wx:if="{{ledgerEditable}}" class="pp-stepper-btn ledger-stepper-btn" data-id="{{item.id}}" data-field="drinkCount" data-delta="1" bindtap="handleAdjustTap"><image class="pp-icon ledger-icon" src="https://cdn.pomer.cn/static/party-pop-clean/icons/step-plus.png" mode="aspectFit"></image></view></view></view>
          </view>
        </view>
      </view>
      <view wx:if="{{ledgerEditable}}" class="pp-button pp-button-lime {{ledgerDirty ? '' : 'pp-button-disabled'}}" style="width: 100%; margin-top: 14px;" bindtap="handleConfirmTap">{{ledgerSubmitting ? '提交中' : '确定修改'}}</view>
    </view>

    <view wx:else class="pp-empty">
      <image class="pp-empty-sticker" src="https://cdn.pomer.cn/static/party-pop-clean/empty-memory-sticker.png" mode="aspectFit"></image>
      <text class="pp-section-title">先进入一场聚会</text>
      <text class="pp-body">首拍后，成员账本会显示在这里。</text>
      <view wx:if="{{showCreateAction}}" class="pp-button pp-button-primary" bindtap="handleCreateTap">创建聚会</view>
    </view>
  </scroll-view>
  <view wx:if="{{hasSession}}" class="pp-fixed-actions"><view class="pp-button pp-button-secondary" bindtap="handleRecordTap">回到记录</view></view>
  <pp-dialog state="{{__ppDialog}}" toast="{{__ppToast}}" loading="{{__ppLoading}}" bind:confirm="__handlePpDialogConfirm" bind:cancel="__handlePpDialogCancel"></pp-dialog>
</view>
