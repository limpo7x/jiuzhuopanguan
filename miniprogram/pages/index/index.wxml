<navigation-bar
  title="聚会记录师"
  back="{{false}}"
  color="#111827"
  background="rgba(255,255,252,0.96)"
  ext-class="home-nav"
></navigation-bar>

<view class="page-shell home-redesign">
  <scroll-view class="screen-body scroll-body with-tabs home-redesign-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="home-stage">
      <view class="home-sticker home-sticker-a">⌁</view>
      <view class="home-sticker home-sticker-b">☆</view>
      <view class="home-camera-mark">▣</view>

      <view class="home-brand-lockup">
        <text class="home-brand-title">聚会记录师</text>
        <text class="home-brand-subtitle">轻松记录每一次聚会的美好时刻</text>
      </view>

      <view class="home-main-actions">
        <button class="home-action-primary party-cta party-cta-primary" bindtap="handlePrimaryTap">
          <text class="home-action-icon">＋</text>
          <text>创建聚会</text>
        </button>
        <view class="home-action-secondary party-cta party-cta-tertiary" bindtap="handleJoinByCodeTap">
          <text class="home-action-icon">⌗</text>
          <text>加入口令/扫码</text>
        </view>
        <view class="home-action-soft party-cta party-cta-secondary" bindtap="handleContinueRecordTap">
          <text class="home-action-icon">◴</text>
          <text>继续记录</text>
        </view>
      </view>

      <view wx:if="{{!loggedIn}}" class="home-login-entry" bindtap="handleLoginTextTap">
        <text class="home-login-title">登录后创建聚会</text>
        <text class="home-login-desc">用于保存房间、相册和成员记录</text>
      </view>
    </view>

    <session-return-bar
      visible="{{sessionReturn.visible}}"
      title="{{sessionReturn.title}}"
      meta="{{sessionReturn.meta}}"
      status="{{sessionReturn.status}}"
      bind:open="handleSessionReturnOpen"
    ></session-return-bar>

    <view class="home-lite-panel">
      <view class="home-lite-head">
        <text class="home-lite-title">最近相册</text>
        <text class="home-lite-link" bindtap="handleAlbumListTap">全部相册</text>
      </view>
      <view class="home-album-strip">
        <view wx:for="{{home.recentTools}}" wx:key="id" class="home-album-shot" data-id="{{item.id}}" data-name="{{item.name}}" data-route="{{item.route}}" bindtap="handleAlbumTap">
          <view class="home-album-image home-album-placeholder">
            <image wx:if="{{item.imageUrl}}" class="home-album-cover" src="{{item.imageUrl}}" mode="aspectFill"></image>
            <text class="home-album-mark">{{item.badgeText}}</text>
          </view>
          <text class="home-album-label">{{item.name}}</text>
          <text wx:if="{{item.usedAt}}" class="home-album-meta">{{item.usedAt}}</text>
        </view>
      </view>
    </view>

  </scroll-view>

  <view class="bottom-nav">
    <view class="bottom-item active" data-tab="home" bindtap="handleTabTap">
      <view class="bottom-icon nav-home active"></view>
      <text class="bottom-label">首页</text>
    </view>
    <view class="bottom-item" data-tab="tools" bindtap="handleTabTap">
      <view class="bottom-icon nav-judge"></view>
      <text class="bottom-label">工具箱</text>
    </view>
    <view class="bottom-item" data-tab="me" bindtap="handleTabTap">
      <view class="bottom-icon nav-me"></view>
      <text class="bottom-label">我的</text>
    </view>
  </view>

  <view wx:if="{{authPanelVisible}}" class="auth-panel-mask" bindtap="closeAuthPanel">
    <form class="auth-panel" catchtap="noop" bindsubmit="handleLoginSubmit">
      <view class="auth-panel-head">
        <text class="auth-panel-title">微信授权登录</text>
        <text class="auth-panel-close" bindtap="closeAuthPanel">关闭</text>
      </view>
      <view class="auth-avatar-row">
        <button class="auth-avatar-btn" open-type="chooseAvatar" bindchooseavatar="handleAuthAvatar">
          <image wx:if="{{authAvatarUrl}}" class="auth-avatar" src="{{authAvatarUrl}}" mode="aspectFill"></image>
          <view wx:else class="auth-avatar"></view>
        </button>
        <view class="auth-avatar-copy">
          <text class="auth-avatar-title">点击头像授权</text>
          <text class="auth-avatar-desc">用于聚会成员展示，不会使用默认图片占位。</text>
        </view>
      </view>
      <input
        class="auth-name-input"
        name="nickname"
        type="nickname"
        placeholder="填写微信昵称"
        value="{{authName}}"
        bindinput="handleAuthNameInput"
      />
      <button class="auth-submit" form-type="submit" loading="{{authSubmitting}}">确认登录</button>
    </form>
  </view>
</view>
