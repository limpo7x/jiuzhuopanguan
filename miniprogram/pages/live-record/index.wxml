<navigation-bar title="" back="{{true}}" customBack="{{true}}" bind:back="handleBackTap" color="#111317" background="transparent" ext-class="pp-nav-page"></navigation-bar>
<view class="pp-page">
  <image class="pp-stage-bg" src="https://cdn.pomer.cn/static/party-pop-clean/app-bg-party-pop-390x844.png" mode="aspectFill"></image>
  <scroll-view class="pp-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="pp-hero live-record-hero">
      <view class="live-refresh-icon" bindtap="handleRefreshTap">
        <image class="live-refresh-icon-img" src="https://cdn.pomer.cn/static/party-pop-clean/icons/action-refresh.png" mode="aspectFit"></image>
      </view>
      <text class="pp-kicker">{{desktopModeLabel || '进行中'}}</text>
      <text class="pp-title">{{sessionName}}</text>
      <text wx:if="{{sessionSubtitle}}" class="pp-body">{{sessionSubtitle}}</text>
      <view class="pp-stat-row" style="margin-top: 16px;">
        <view class="pp-stat"><text class="pp-stat-value">{{memberCountText}}</text><text class="pp-stat-label">成员</text></view>
        <view class="pp-stat"><text class="pp-stat-value">{{elapsedText}}</text><text class="pp-stat-label">时长</text></view>
      </view>
      <view wx:if="{{players.length}}" class="live-avatar-scroll">
        <view class="live-avatar-row">
          <view wx:for="{{players}}" wx:key="profileId" class="live-avatar-item">
            <view class="pp-avatar live-avatar"><image wx:if="{{item.avatarUrl}}" class="pp-avatar live-avatar" src="{{item.avatarUrl}}" mode="aspectFill"></image><text wx:else>{{item.initial}}</text></view>
            <text class="live-avatar-name">{{item.name}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="pp-tabs">
      <view class="pp-tab {{activeSegment === 'record' ? 'pp-tab-active' : ''}}" data-tab="record" bindtap="handleSegmentTap">记录</view>
      <view class="pp-tab {{activeSegment === 'album' ? 'pp-tab-active' : ''}}" data-tab="album" bindtap="handleSegmentTap">相册</view>
      <view class="pp-tab {{activeSegment === 'ledger' ? 'pp-tab-active' : ''}}" data-tab="ledger" bindtap="handleSegmentTap">账本</view>
      <view class="pp-tab {{activeSegment === 'share' ? 'pp-tab-active' : ''}}" data-tab="share" bindtap="handleSegmentTap">分享</view>
    </view>

    <view wx:if="{{activeSegment === 'record'}}" class="pp-panel">
      <text class="pp-section-title">现场时间线</text>
      <view wx:if="{{timelineLoading}}" class="pp-loading" style="margin-top: 14px;"><view class="pp-loading-dot"></view><text>时间线同步中</text></view>
      <view wx:elif="{{recordTimelineDisplayItems.length}}" class="pp-timeline live-record-timeline" style="margin-top: 14px;">
        <view wx:for="{{recordTimelineDisplayItems}}" wx:key="id" class="pp-timeline-item" data-id="{{item.id}}" data-node-kind="{{item.nodeKind}}" bindtap="handleTimelineSelect">
          <view class="live-timeline-head"><text class="pp-caption">{{item.timeText}}</text><text class="live-action-tag live-action-tag-{{item.type}}">{{item.actionLabel}}</text></view>
          <text class="pp-list-title">{{item.title}}</text>
          <image wx:if="{{item.imageUrl && !item.imageBroken}}" class="pp-cover" style="width: 100%; height: 148px; margin-top: 10px;" src="{{item.imageUrl}}" mode="aspectFill" data-id="{{item.id}}" bindload="handlePhotoImageLoad" binderror="handlePhotoImageError"></image>
          <text class="pp-body">{{item.detail}}</text>
        </view>
      </view>
      <view wx:else class="pp-empty">
        <image class="pp-empty-sticker" src="https://cdn.pomer.cn/static/party-pop-clean/empty-memory-sticker.png" mode="aspectFit"></image>
        <text class="pp-body">{{timelineEmptyText}}</text>
      </view>
      <text wx:if="{{hiddenTimelineNotice}}" class="pp-caption">{{hiddenTimelineNotice}}</text>
    </view>

    <view wx:if="{{activeSegment === 'album'}}" class="pp-panel">
      <text class="pp-section-title">本局相册</text>
      <view wx:if="{{photoNodes.length}}" class="pp-photo-grid" style="margin-top: 14px;">
        <view wx:for="{{photoNodes}}" wx:key="id" class="pp-photo-tile" data-id="{{item.id}}" data-node-kind="{{item.nodeKind}}" bindtap="handleTimelineSelect">
          <image wx:if="{{item.imageUrl && !item.imageBroken}}" src="{{item.imageUrl}}" mode="aspectFill" data-id="{{item.id}}" bindload="handlePhotoImageLoad" binderror="handlePhotoImageError"></image>
          <view wx:else class="pp-photo-fallback">照片</view>
        </view>
      </view>
      <view wx:else class="pp-empty"><image class="pp-empty-sticker" src="https://cdn.pomer.cn/static/party-pop-clean/photo-upload-sticker.png" mode="aspectFit"></image><text class="pp-body">{{timelineEmptyText}}</text></view>
    </view>

    <view wx:if="{{activeSegment === 'ledger'}}" class="pp-stack">
      <view class="pp-panel">
        <view class="pp-row-between"><text class="pp-section-title">聚会账本</text><text class="pp-chip">{{isJudge ? '可编辑' : '只读'}}</text></view>
        <view class="pp-list" style="margin-top: 14px;">
          <view wx:for="{{records}}" wx:key="id" class="pp-list-item live-ledger-row">
            <view class="pp-brand live-ledger-player"><view class="pp-avatar live-ledger-avatar"><image wx:if="{{item.avatarUrl}}" class="pp-avatar live-ledger-avatar" src="{{item.avatarUrl}}" mode="aspectFill"></image><text wx:else>{{item.name}}</text></view><text class="pp-list-title live-ledger-name">{{item.name}}</text></view>
            <view class="live-ledger-controls">
              <view class="live-ledger-metric"><text class="live-ledger-label">欠酒</text><view class="pp-stepper live-ledger-stepper"><view wx:if="{{isJudge}}" class="pp-stepper-btn live-ledger-stepper-btn" data-id="{{item.id}}" data-field="debtCount" data-delta="-1" bindtap="handleAdjustTap"><image class="pp-icon live-ledger-icon" src="https://cdn.pomer.cn/static/party-pop-clean/icons/step-minus.png" mode="aspectFit"></image></view><text class="pp-stepper-value live-ledger-value">{{item.debtCount}}</text><view wx:if="{{isJudge}}" class="pp-stepper-btn live-ledger-stepper-btn" data-id="{{item.id}}" data-field="debtCount" data-delta="1" bindtap="handleAdjustTap"><image class="pp-icon live-ledger-icon" src="https://cdn.pomer.cn/static/party-pop-clean/icons/step-plus.png" mode="aspectFit"></image></view></view></view>
              <view class="live-ledger-metric"><text class="live-ledger-label">加酒</text><view class="pp-stepper live-ledger-stepper"><view wx:if="{{isJudge}}" class="pp-stepper-btn live-ledger-stepper-btn" data-id="{{item.id}}" data-field="drinkCount" data-delta="-1" bindtap="handleAdjustTap"><image class="pp-icon live-ledger-icon" src="https://cdn.pomer.cn/static/party-pop-clean/icons/step-minus.png" mode="aspectFit"></image></view><text class="pp-stepper-value live-ledger-value">{{item.drinkCount}}</text><view wx:if="{{isJudge}}" class="pp-stepper-btn live-ledger-stepper-btn" data-id="{{item.id}}" data-field="drinkCount" data-delta="1" bindtap="handleAdjustTap"><image class="pp-icon live-ledger-icon" src="https://cdn.pomer.cn/static/party-pop-clean/icons/step-plus.png" mode="aspectFit"></image></view></view></view>
            </view>
          </view>
        </view>
        <view wx:if="{{isJudge && records.length}}" class="pp-button pp-button-lime {{ledgerDirty ? '' : 'pp-button-disabled'}}" style="width: 100%; margin-top: 14px;" bindtap="handleConfirmLedgerTap">{{ledgerSubmitting ? '提交中' : '确定修改'}}</view>
      </view>
    </view>

    <view wx:if="{{activeSegment === 'share'}}" class="pp-panel pp-panel-yellow">
      <text class="pp-section-title">分享图</text>
      <text class="pp-body">结束聚会后会交给服务器生成超长回忆录，稍后可在相册记录里保存到手机。</text>
      <view class="pp-button pp-button-secondary" style="width: 100%; margin-top: 14px;" bindtap="handleOpenShareAlbumTap">
        <text>打开分享图相册</text>
      </view>
    </view>
  </scroll-view>
  <view wx:if="{{activeSegment === 'record' || activeSegment === 'album' || activeSegment === 'share'}}" class="pp-fixed-actions">
    <block wx:if="{{!sessionEnded}}">
      <view class="pp-button pp-button-secondary {{quickPhotoSaving || finishSaving ? 'pp-button-disabled' : ''}}" bindtap="handleHighlightMomentTap"><image class="pp-icon" src="https://cdn.pomer.cn/static/party-pop-clean/icons/action-camera.png" mode="aspectFit"></image><text>{{quickPhotoSaving ? '保存中' : '继续拍照'}}</text></view>
      <view class="pp-button pp-button-primary {{finishSaving ? 'pp-button-disabled' : ''}}" bindtap="handleFinishTap"><image class="pp-icon" src="https://cdn.pomer.cn/static/party-pop-clean/icons/action-end.png" mode="aspectFit"></image><text>{{finishSaving ? '保存中' : finishMatchLabel}}</text></view>
    </block>
    <block wx:else>
      <view class="pp-button pp-button-secondary" bindtap="handleOpenShareAlbumTap"><image class="pp-icon" src="https://cdn.pomer.cn/static/party-pop-clean/icons/action-album.png" mode="aspectFit"></image><text>去相册下载</text></view>
      <view class="pp-button pp-button-primary {{finishSaving ? 'pp-button-disabled' : ''}}" bindtap="handleSaveEndedPosterTap"><image class="pp-icon" src="https://cdn.pomer.cn/static/party-pop-clean/icons/action-end.png" mode="aspectFit"></image><text>{{finishSaving ? '保存中' : finishMatchLabel}}</text></view>
    </block>
  </view>
  <view wx:if="{{photoPreviewVisible}}" class="{{photoPreviewClass}}" catchtap="handlePhotoPreviewCloseTap">
    <view class="{{photoPreviewStageClass}}" catchtap="handlePhotoPreviewStopTap">
      <image class="live-photo-preview-image" src="{{photoPreviewImageUrl}}" mode="aspectFit"></image>
      <view wx:if="{{photoPreviewInfoVisible}}" class="live-photo-preview-info">
        <text wx:if="{{photoPreviewTitle}}" class="live-photo-preview-title">{{photoPreviewTitle}}</text>
        <text wx:if="{{photoPreviewCaption}}" class="live-photo-preview-caption">{{photoPreviewCaption}}</text>
      </view>
    </view>
  </view>
  <pp-dialog state="{{__ppDialog}}" bind:confirm="__handlePpDialogConfirm" bind:cancel="__handlePpDialogCancel"></pp-dialog>
</view>
