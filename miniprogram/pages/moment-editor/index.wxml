<navigation-bar title="{{title}}" back="{{true}}" customBack="{{true}}" bind:back="handleBackTap" color="#111317" background="transparent" ext-class="pp-nav-page"></navigation-bar>
<view class="pp-page">
  <image class="pp-stage-bg" src="https://cdn.pomer.cn/static/party-pop-clean/stage-bg-390x844.png" mode="aspectFill"></image>
  <scroll-view class="pp-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="pp-hero">
      <view wx:if="{{!detailMode}}" class="pp-flow">
        <view class="pp-flow-step pp-flow-step-done"><text class="pp-flow-index">1</text><text class="pp-flow-label">创建</text></view>
        <view class="pp-flow-line pp-flow-line-active"></view>
        <view class="pp-flow-step pp-flow-step-done"><text class="pp-flow-index">2</text><text class="pp-flow-label">邀请</text></view>
        <view class="pp-flow-line pp-flow-line-active"></view>
        <view class="pp-flow-step pp-flow-step-active"><text class="pp-flow-index">3</text><text class="pp-flow-label">拍照</text></view>
      </view>
      <text class="pp-kicker">{{detailMode ? '照片详情' : '首拍记录'}}</text>
      <text class="pp-title">{{title}}</text>
      <text class="pp-body">一句话说明收缩到两行内，授权默认四项全选。</text>
    </view>

    <view class="pp-panel">
      <text class="pp-section-title">照片</text>
      <view wx:if="{{draftImageFilePath || imageUrl}}" class="pp-photo" style="height: 230px; margin-top: 12px;">
        <image src="{{draftImageFilePath || imageUrl}}" mode="aspectFill" style="width: 100%; height: 100%;"></image>
      </view>
      <view wx:else class="pp-empty" bindtap="handleChooseImage">
        <image class="pp-empty-sticker" src="https://cdn.pomer.cn/static/party-pop-clean/photo-upload-sticker.png" mode="aspectFit"></image>
        <text class="pp-section-title">选择第一张照片</text>
        <text class="pp-body">从相册选择或重新上传。</text>
      </view>
      <view class="pp-action-row" style="margin-top: 12px;">
        <view class="pp-button pp-button-secondary" bindtap="handleChooseImage"><image class="pp-icon" src="https://cdn.pomer.cn/static/party-pop-clean/icons/action-camera.png" mode="aspectFit"></image><text>从相册选择</text></view>
        <view wx:if="{{uploadError}}" class="pp-button pp-button-ghost" bindtap="handleRetryUploadTap">重试上传</view>
      </view>
    </view>

    <view class="pp-panel">
      <view class="pp-row-between"><text class="pp-section-title">一句话说明</text><text class="pp-caption">{{caption.length}} / 80</text></view>
      <textarea class="pp-textarea" maxlength="80" value="{{caption}}" placeholder="写一句现场回忆" placeholder-class="pp-placeholder" bindinput="handleCaptionInput" style="margin-top: 12px;"></textarea>
      <scroll-view class="moment-chip-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="pp-chip-row moment-chip-row">
          <view wx:for="{{captionPresets}}" wx:key="text" class="pp-chip" data-text="{{item.text}}" bindtap="handleCaptionPresetTap">{{item.text}}</view>
        </view>
      </scroll-view>
    </view>

    <view class="pp-panel">
      <text class="pp-section-title">可见范围</text>
      <scroll-view class="moment-chip-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="pp-chip-row moment-chip-row">
          <view wx:for="{{nodeOptions}}" wx:key="value" class="pp-chip {{nodeType === item.value ? 'pp-chip-active' : ''}}" data-value="{{item.value}}" bindtap="handleNodeTypeTap">{{item.label}}</view>
        </view>
      </scroll-view>
      <scroll-view class="moment-chip-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="pp-chip-row moment-chip-row">
          <view wx:for="{{authorizationOptions}}" wx:key="key" class="pp-chip {{item.checked ? 'pp-chip-active' : ''}}" data-key="{{item.key}}" bindtap="handleConsentTap">{{item.label}}</view>
        </view>
      </scroll-view>
    </view>

    <view wx:if="{{showVisibleMemberPicker}}" class="pp-panel">
      <text class="pp-section-title">可见成员</text>
      <scroll-view class="moment-chip-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="pp-chip-row moment-chip-row">
          <view wx:for="{{memberOptions}}" wx:key="profileId" class="pp-chip {{item.active ? 'pp-chip-active' : ''}}" data-profile-id="{{item.profileId}}" bindtap="handleMemberTap">{{item.name}}</view>
        </view>
      </scroll-view>
    </view>
  </scroll-view>
  <view class="pp-fixed-actions">
    <view class="pp-button pp-button-ghost" bindtap="handleBackTap">返回</view>
    <view class="pp-button pp-button-primary {{saving || uploading ? 'pp-button-disabled' : ''}}" bindtap="handleSubmitTap">{{saving ? '保存中' : submitLabel}}</view>
  </view>
  <pp-dialog state="{{__ppDialog}}" toast="{{__ppToast}}" loading="{{__ppLoading}}" bind:confirm="__handlePpDialogConfirm" bind:cancel="__handlePpDialogCancel"></pp-dialog>
</view>
