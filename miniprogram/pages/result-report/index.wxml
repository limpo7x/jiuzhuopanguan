<navigation-bar
  title="本局战报"
  back="{{true}}"
  customBack="{{true}}"
  bind:back="handleBackTap"
  color="#24160f"
  background="rgba(255,253,248,0.96)"
  ext-class="report-nav"
></navigation-bar>

<view class="report-page">
  <scroll-view class="report-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="report-poster-card">
      <view class="report-poster-copy">
        <view class="report-tag">本局战报</view>
        <text class="report-title">{{reportTitle}}</text>
        <text class="report-meta">{{metaText}}</text>

        <view wx:if="{{featuredRank}}" class="report-featured-rank">
          <view class="report-featured-head">
            <view class="report-featured-tag">{{featuredRank.title}}</view>
            <view class="report-featured-badge">全场焦点</view>
          </view>
          <view class="report-featured-body">
            <image wx:if="{{featuredRank.avatarUrl}}" class="report-featured-avatar" src="{{featuredRank.avatarUrl}}" mode="aspectFill"></image>
            <view wx:else class="report-featured-avatar"></view>
            <view class="report-featured-copy">
              <text class="report-featured-name">{{featuredRank.name}}</text>
              <text class="report-featured-value">{{featuredRank.value}}</text>
            </view>
          </view>
        </view>

        <view wx:if="{{secondaryRanks.length}}" class="report-ranks">
          <view wx:for="{{secondaryRanks}}" wx:key="title" class="report-rank-card">
            <view class="report-rank-tag">{{item.title}}</view>
            <image wx:if="{{item.avatarUrl}}" class="report-rank-avatar" src="{{item.avatarUrl}}" mode="aspectFill"></image>
            <view wx:else class="report-rank-avatar"></view>
            <text class="report-rank-name">{{item.name}}</text>
            <text class="report-rank-value">{{item.value}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="report-section-head">
      <text class="report-section-title">本局精彩事件</text>
    </view>

    <view class="report-card report-form-card">
      <text wx:for="{{events}}" wx:key="text" class="report-event-text">· {{item.text}}</text>
    </view>

    <view class="report-action-row">
      <view class="report-ghost" bindtap="handleRestartTap">再开一局</view>
      <view class="report-primary" bindtap="handleShareTap">分享战报</view>
    </view>

    <view class="report-notice">
      <view class="report-notice-icon"></view>
      <text>理性饮酒，适量玩局，未成年人禁止饮酒。</text>
    </view>
  </scroll-view>
</view>
