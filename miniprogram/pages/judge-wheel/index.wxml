<navigation-bar
  title="判官转盘"
  back="{{true}}"
  color="#24160f"
  background="rgba(255,253,248,0.96)"
  ext-class="wheel-nav"
></navigation-bar>

<view class="wheel-page">
  <scroll-view class="wheel-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="wheel-board">
      <view class="wheel-pointer"></view>
      <view
        class="wheel-disc"
        style="transform: rotate({{rotationDeg}}deg); transition: transform {{rotationDuration}}ms cubic-bezier(0.16, 1, 0.3, 1);"
      >
        <view wx:for="{{wheelQuestions}}" wx:key="text" class="wheel-name" style="{{item.labelStyle}}">
          <text>{{item.shortLabel}}</text>
        </view>
      </view>
      <view class="wheel-center {{isSpinning ? 'wheel-center-spinning' : ''}}" bindtap="handleSpinTap">
        <text>{{isSpinning ? '转动中' : '转一转'}}</text>
      </view>
    </view>

    <view class="wheel-card wheel-form-card">
      <view class="wheel-row-top">
        <image class="wheel-avatar" src="{{currentPlayerAvatar}}" mode="aspectFill"></image>
        <view class="wheel-copy">
          <text class="wheel-picked-name">{{currentPlayerName}}</text>
          <text class="wheel-picked-meta">当前欠酒 {{currentDebtCount}} 杯 · 已消 {{currentClearedCount}} / {{maxClearPerPlayer}}</text>
          <text class="wheel-picked-task">“{{currentTask}}”</text>
        </view>
      </view>
      <view class="wheel-action-row">
        <view class="wheel-primary" bindtap="handleAcceptTap">完成消 1 杯</view>
      </view>
    </view>

    <view class="wheel-section-head">
      <text class="wheel-section-title">本轮消杯说明</text>
    </view>

    <view class="wheel-pill-row">
      <view wx:for="{{history}}" wx:key="text" class="wheel-pill {{item.active ? 'wheel-pill-active' : ''}}">{{item.text}}</view>
    </view>
  </scroll-view>
</view>
