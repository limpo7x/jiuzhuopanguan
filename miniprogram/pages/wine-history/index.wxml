<navigation-bar
  title="我的酒局"
  back="{{true}}"
  color="#24160f"
  background="rgba(255,253,248,0.96)"
  ext-class="history-nav"
></navigation-bar>

<view class="history-page">
  <scroll-view class="history-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="history-chip-row">
      <view
        wx:for="{{filters}}"
        wx:key="name"
        class="history-chip {{item.active ? 'history-chip-active' : ''}}"
        data-name="{{item.name}}"
        bindtap="handleFilterTap"
      >
        {{item.name}}
      </view>
    </view>

    <view wx:if="{{!loading && visibleSessions.length}}" class="history-list">
      <view
        wx:for="{{visibleSessions}}"
        wx:key="id"
        class="history-item"
        data-record-type="{{item.recordType}}"
        data-report-id="{{item.reportId}}"
        data-session-id="{{item.sessionId}}"
        data-status="{{item.status}}"
        bindtap="handleSessionTap"
      >
        <view class="history-thumb">
          <image src="{{item.imageUrl}}" mode="aspectFill"></image>
        </view>
        <view class="history-copy">
          <text class="history-title">{{item.name}}</text>
          <text class="history-meta">{{item.meta}}</text>
        </view>
        <view class="history-tag {{item.status === '已结束' ? 'history-tag-green' : ''}}">{{item.tag}}</view>
      </view>
    </view>

    <view wx:elif="{{!loading}}" class="history-empty">
      <text class="history-empty-title">暂无真实酒局记录</text>
      <text class="history-empty-meta">创建、加入并完成一局后，这里会展示真实状态和战报。</text>
    </view>

    <view class="history-primary" bindtap="handleCreateTap">创建新酒局</view>
  </scroll-view>
</view>
