<navigation-bar title="我的聚友" back="{{true}}" customBack="{{true}}" bind:back="handleBackTap" color="#111317" background="transparent" ext-class="pp-nav-page"></navigation-bar>
<view class="pp-page">
  <image class="pp-stage-bg" src="https://cdn.pomer.cn/static/party-pop-clean/stage-bg-390x844.png" mode="aspectFill"></image>
  <scroll-view class="pp-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="pp-hero pp-panel-cyan"><text class="pp-title">我的聚友</text><text class="pp-body">仅显示你参与过的聚会好友，支持拍一拍和删除。</text></view>
    <input class="pp-input" placeholder="输入好友昵称" placeholder-class="pp-placeholder" value="{{newFriendName}}" bindinput="handleNewFriendInput" />
    <view class="pp-tabs friend-hub-tabs">
      <view class="pp-tab {{activeFriendCategory === 'played' ? 'pp-tab-active' : ''}}" data-category="played" bindtap="handleFriendCategoryTap">已合拍 {{playedFriends.length}}</view>
      <view class="pp-tab {{activeFriendCategory === 'unplayed' ? 'pp-tab-active' : ''}}" data-category="unplayed" bindtap="handleFriendCategoryTap">未合拍 {{unplayedFriends.length}}</view>
    </view>
    <view wx:if="{{pokeCards.length}}" class="pp-panel friend-hub-pokes">
      <view class="pp-row-between friend-hub-section-head">
        <text class="pp-section-title">互动提醒</text>
        <text class="pp-caption">拍一拍会同步给对方</text>
      </view>
      <view class="pp-list friend-hub-poke-list">
        <view wx:for="{{pokeCards}}" wx:key="id" class="pp-list-item friend-hub-poke-card">
          <view class="pp-avatar">
            <image wx:if="{{item.avatarUrl}}" class="pp-avatar" src="{{item.avatarUrl}}" mode="aspectFill"></image>
            <text wx:else>拍</text>
          </view>
          <view class="pp-list-copy">
            <text class="pp-list-title">{{item.name}}</text>
            <text class="pp-caption">{{item.message}}</text>
          </view>
          <view wx:if="{{item.actionState === 'incoming'}}" class="friend-hub-actions">
            <view class="pp-chip friend-hub-chip" data-id="{{item.id}}" data-action="reply" catchtap="handlePokeActionTap">回拍</view>
            <view class="pp-chip friend-hub-chip" data-id="{{item.id}}" data-action="ignore" catchtap="handlePokeActionTap">忽略</view>
          </view>
          <view wx:else class="pp-chip friend-hub-status {{item.actionState === 'matched' ? 'pp-chip-active' : ''}}">{{item.statusLabel}}</view>
        </view>
      </view>
    </view>
    <view wx:if="{{visibleFriends.length}}" class="pp-list friend-hub-list">
      <view wx:for="{{visibleFriends}}" wx:key="profileId" class="pp-list-item friend-hub-card">
        <view class="pp-avatar"><image wx:if="{{item.avatarUrl}}" class="pp-avatar" src="{{item.avatarUrl}}" mode="aspectFill"></image><text wx:else>友</text></view>
        <view class="pp-list-copy"><text class="pp-list-title">{{item.name}}</text><text class="pp-caption">{{item.meta || '一起记录过聚会'}}</text></view>
        <view class="friend-hub-actions">
          <view class="pp-chip friend-hub-chip friend-hub-poke-btn {{item.canPokeAgain ? '' : 'friend-hub-chip-disabled'}}" data-id="{{item.id}}" catchtap="handlePokeTap">
            <image class="friend-hub-clink-icon" src="https://cdn.pomer.cn/static/party-pop-clean/icons/action-clink.png" mode="aspectFit"></image>
            <text>拍一拍</text>
          </view>
          <view class="friend-hub-delete-btn" data-id="{{item.id}}" catchtap="handleDeleteFriendTap">×</view>
        </view>
        <text wx:if="{{item.coPlayCountText}}" class="friend-hub-count">{{item.coPlayCountText}}</text>
      </view>
    </view>
    <view wx:if="{{!visibleFriends.length}}" class="pp-empty"><text class="pp-section-title">{{wineFriends.length ? '这个分类暂无聚友' : '还没有聚友'}}</text><text class="pp-body">{{wineFriends.length ? '切换分类或调整昵称搜索。' : '一起参加聚会后会展示在这里。'}}</text></view>
  </scroll-view>
  <pp-dialog state="{{__ppDialog}}" toast="{{__ppToast}}" loading="{{__ppLoading}}" bind:confirm="__handlePpDialogConfirm" bind:cancel="__handlePpDialogCancel"></pp-dialog>
</view>
