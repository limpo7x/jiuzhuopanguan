<navigation-bar
  title="我的聚友"
  back="{{true}}"
  color="#24160f"
  background="rgba(255,253,248,0.96)"
></navigation-bar>

<view class="friend-hub-page">
  <scroll-view class="friend-hub-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="friend-hub-profile">
      <image class="friend-hub-avatar" src="{{currentProfile.avatarUrl}}" mode="aspectFill"></image>
      <view class="friend-hub-copy">
        <text class="friend-hub-name">{{currentProfile.name}}</text>
        <text class="friend-hub-meta">仅显示你参与过的酒局中的聚友，支持拍一拍和删除。</text>
      </view>
    </view>

    <view class="friend-hub-create">
      <input class="friend-hub-input" value="{{newFriendName}}" placeholder="搜索聚友昵称/ID" bindinput="handleNewFriendInput" />
    </view>

    <view wx:if="{{newFriendMatches.length}}" class="friend-hub-search-list">
      <view wx:for="{{newFriendMatches}}" wx:key="id" class="friend-hub-search-card">
        <image class="friend-hub-friend-avatar" src="{{item.avatarUrl}}" mode="aspectFill"></image>
        <view class="friend-hub-friend-copy">
          <text class="friend-hub-friend-name">{{item.name}}</text>
          <text class="friend-hub-friend-meta">{{item.identityTag}}</text>
        </view>
      </view>
    </view>

    <view class="friend-hub-list">
      <view wx:for="{{wineFriends}}" wx:key="id" class="friend-hub-card">
        <image class="friend-hub-friend-avatar" src="{{item.avatarUrl}}" mode="aspectFill"></image>
        <view class="friend-hub-friend-copy">
          <text class="friend-hub-friend-name">{{item.name}}</text>
          <text class="friend-hub-friend-meta">{{item.meta}}</text>
        </view>
        <view class="friend-hub-actions">
          <view class="friend-hub-poke-btn" data-id="{{item.id}}" bindtap="handlePokeTap">拍一拍</view>
          <view class="friend-hub-mini-row">
            <view class="friend-hub-mini-btn friend-hub-delete-btn" data-id="{{item.id}}" bindtap="handleDeleteFriendTap">删除</view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
