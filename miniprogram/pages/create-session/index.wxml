<navigation-bar
  title="创建聚会"
  back="{{true}}"
  color="#111827"
  background="rgba(255,255,252,0.96)"
  ext-class="create-nav"
></navigation-bar>

<view class="create-page create-redesign">
  <scroll-view class="create-scroll create-redesign-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="create-step-line">
      <view class="create-step-pill create-step-pill-active">1 创建</view>
      <view class="create-step-pill">2 邀请</view>
      <view class="create-step-pill">3 拍照</view>
    </view>

    <view class="create-hero">
      <text class="create-title">创建聚会</text>
      <text class="create-subtitle">默认生成房间和邀请方式，马上拍第一张照片。</text>
      <view class="create-confetti">✦</view>
    </view>

    <view class="create-form">
      <view class="create-input-row">
        <text class="create-input-icon">✎</text>
        <input
          class="create-input"
          value="{{sessionName}}"
          placeholder="今晚的聚会"
          placeholder-class="create-input-placeholder"
          bindinput="handleSessionNameInput"
        />
      </view>

      <view class="create-name-preset-row">
        <view
          wx:for="{{sessionNamePresets}}"
          wx:key="name"
          class="create-name-preset-chip {{item.active ? 'create-name-preset-chip-active' : ''}}"
          data-name="{{item.name}}"
          bindtap="handlePresetTap"
        >{{item.name}}</view>
      </view>

      <view class="create-input-row">
        <text class="create-input-icon">◷</text>
        <text class="create-input-static">{{currentTimeText}}</text>
        <text class="create-input-arrow">›</text>
      </view>
    </view>

    <view class="create-advanced-row" bindtap="handleMoreTemplatesTap">
      <text>高级设置</text>
      <text>人数 {{playerCount}} 人 · 可直接调整</text>
      <text class="create-advanced-arrow">⌄</text>
    </view>

    <view class="create-player-count-panel">
      <view class="create-player-count-copy">
        <text class="create-player-count-title">今晚聚会人数</text>
        <text class="create-player-count-desc">2 到 12 人，创建后用于邀请名额和账本成员数。</text>
      </view>
      <view class="create-stepper create-player-count-stepper">
        <view
          class="create-stepper-btn create-player-count-minus {{playerCount <= 2 ? 'create-stepper-btn-disabled' : ''}}"
          data-action="minus"
          bindtap="handlePlayerCountTap"
        >−</view>
        <text class="create-stepper-value create-player-count-value">{{playerCount}} 人</text>
        <view
          class="create-stepper-btn create-player-count-plus {{playerCount >= 12 ? 'create-stepper-btn-disabled' : ''}}"
          data-action="plus"
          bindtap="handlePlayerCountTap"
        >＋</view>
      </view>
    </view>

    <view class="create-notice">
      <view class="create-notice-icon create-icon-shield"></view>
      <text>默认仅本聚会成员可见，公开分享需单独授权。</text>
    </view>
  </scroll-view>

  <view class="create-bottom-bar">
    <view class="create-primary party-cta party-cta-primary" bindtap="handleNextTap">
      <text>创建并邀请</text>
    </view>
  </view>
</view>
