<navigation-bar
  title="创建酒局"
  back="{{true}}"
  color="#24160f"
  background="rgba(255,253,248,0.96)"
  ext-class="create-nav"
></navigation-bar>

<view class="create-page">
  <scroll-view class="create-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="create-progress">
      <view class="create-progress-step create-progress-step-active">
        <text class="create-progress-dot">1</text>
        <text>创建酒局</text>
      </view>
      <view class="create-progress-step">
        <text class="create-progress-dot">2</text>
        <text>玩法设置</text>
      </view>
      <view class="create-progress-step">
        <text class="create-progress-dot">3</text>
        <text>邀请开局</text>
      </view>
    </view>

    <view class="create-card create-form-card">
      <view class="create-field">
        <text class="create-label">酒局名称</text>
        <input
          class="create-input"
          value="{{sessionName}}"
          placeholder="请输入酒局名称"
          placeholder-class="create-input-placeholder"
          bindinput="handleSessionNameInput"
        />
      </view>

      <view class="create-pill-row">
        <view
          wx:for="{{sessionNamePresets}}"
          wx:key="name"
          class="create-pill {{item.active ? 'create-pill-active' : ''}}"
          data-name="{{item.name}}"
          bindtap="handlePresetTap"
        >{{item.name}}</view>
      </view>

      <view class="create-field">
        <text class="create-label">选择人数</text>
        <view class="create-row-between">
          <view class="create-stepper">
            <view class="create-stepper-btn" data-action="minus" bindtap="handlePlayerCountTap">-</view>
            <text class="create-stepper-value">{{playerCount}}人</text>
            <view class="create-stepper-btn" data-action="plus" bindtap="handlePlayerCountTap">+</view>
          </view>
          <text class="create-tiny">支持 2-12 人</text>
        </view>
      </view>
    </view>

    <view class="create-section-head">
      <view class="create-section-copy">
        <text class="create-section-title">选择玩法模板</text>
        <text class="create-section-subtitle">先选氛围，后面再细调规则</text>
      </view>
      <view class="create-section-link" bindtap="handleMoreTemplatesTap">更多模板</view>
    </view>

    <view wx:if="{{templatesLoading && !templates.length}}" class="create-template-skeletons">
      <view class="create-template-skeleton"></view>
      <view class="create-template-skeleton"></view>
    </view>

    <scroll-view wx:elif="{{templates.length}}" class="create-template-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="create-template-row">
        <view
          wx:for="{{templates}}"
          wx:key="id"
          class="create-template-card {{item.active ? 'create-template-card-active' : ''}}"
          data-id="{{item.id}}"
          bindtap="handleTemplateTap"
        >
          <image wx:if="{{item.imageUrl}}" class="create-template-image" src="{{item.imageUrl}}" mode="aspectFill"></image>
          <view wx:else class="create-template-image"></view>
          <view class="create-template-body">
            <view class="create-template-topline">
              <text class="create-template-name">{{item.name}}</text>
              <text class="create-template-status">{{item.active ? '已选' : '免费'}}</text>
            </view>
            <text class="create-template-meta">{{item.meta}}</text>
          </view>
        </view>
      </view>
    </scroll-view>

    <view wx:else class="create-template-empty">
      <text>模板暂时加载失败，请稍后重试</text>
    </view>

    <view class="create-notice">
      <view class="create-notice-icon create-icon-shield"></view>
      <text>理性饮酒，适量饮酒，未成年人禁止饮酒</text>
    </view>
  </scroll-view>

  <view class="create-bottom-bar">
    <view class="create-primary" bindtap="handleNextTap">
      <text>下一步 设置玩法</text>
      <view class="create-primary-icon create-icon-arrow"></view>
    </view>
  </view>
</view>
