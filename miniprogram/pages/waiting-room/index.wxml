<navigation-bar
  title="等待开局"
  back="{{true}}"
  customBack="{{true}}"
  bind:back="handleBackTap"
  color="#24160f"
  background="rgba(255,253,248,0.96)"
  ext-class="waiting-nav"
></navigation-bar>

<view class="waiting-page">
  <scroll-view class="waiting-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="waiting-center">
      <text class="waiting-title">组局中，等人齐</text>
      <text class="waiting-subtitle">可随时刷新最新加入成员，确认人数后再进场。</text>
      <view class="waiting-counter">
        <text class="waiting-counter-value">{{joinedCount}} / {{playerCount}}</text>
        <text class="waiting-counter-label">已加入人数</text>
      </view>
      <view class="waiting-hero-actions">
        <view class="waiting-hero-btn waiting-hero-btn-soft" bindtap="handleRefreshTap">
          <text class="waiting-hero-btn-icon">↻</text>
          <text>刷新成员</text>
        </view>
        <view wx:if="{{isJudge && joinedCount < playerCount}}" class="waiting-hero-btn waiting-hero-btn-hot" bindtap="handleInviteTap">
          <text class="waiting-hero-btn-icon">+</text>
          <text>继续邀请</text>
        </view>
      </view>
    </view>

    <view class="waiting-avatar-row">
      <view wx:for="{{joinedPlayers}}" wx:key="name" class="waiting-avatar-card">
        <image wx:if="{{item.avatarUrl}}" class="waiting-avatar" src="{{item.avatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="waiting-avatar"></view>
        <text class="waiting-avatar-name">{{item.name}}</text>
      </view>
      <view wx:for="{{emptySeats}}" wx:key="index" class="waiting-avatar-card">
        <view class="waiting-avatar waiting-avatar-empty">?</view>
        <text class="waiting-avatar-name">待加入</text>
      </view>
    </view>

    <view class="waiting-card">
      <view class="waiting-row-between">
        <text class="waiting-card-title">聚会信息</text>
        <text class="waiting-card-link" bindtap="handleOverviewTap">更多</text>
      </view>
      <text class="waiting-card-meta">{{sessionName}}</text>
      <text class="waiting-card-meta">人数：{{playerCount}} 人</text>
      <text class="waiting-card-meta">邀请码：{{inviteCode}}</text>
    </view>

    <view class="waiting-action-row">
      <view wx:if="{{isJudge}}" class="waiting-ghost waiting-ghost-hot" bindtap="handleOpeningMomentTap">开局签到</view>
      <view wx:if="{{isJudge && joinedCount < playerCount}}" class="waiting-ghost" bindtap="handleInviteTap">提醒好友</view>
      <view class="waiting-ghost" bindtap="handleCodeTap">查看邀请卡</view>
    </view>
  </scroll-view>

  <!-- waiting fixed primary action -->
  <view class="waiting-primary" bindtap="handleStartTap">进入本局</view>

</view>
