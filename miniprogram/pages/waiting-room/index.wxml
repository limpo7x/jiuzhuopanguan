<navigation-bar title="等待开局" back="{{true}}" customBack="{{true}}" bind:back="handleBackTap" color="#111317" background="transparent" ext-class="pp-nav-page"></navigation-bar>
<view class="pp-page">
  <image class="pp-stage-bg" src="https://cdn.pomer.cn/static/party-pop-clean/app-bg-party-pop-390x844.png" mode="aspectFill"></image>
  <scroll-view class="pp-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="pp-hero pp-panel-cyan">
      <text class="pp-kicker">{{sessionName || '聚会房间'}}</text>
      <text class="pp-title">{{statusTitle}}</text>
      <text class="pp-body">{{statusSubtitle}}</text>
      <view class="pp-stat-row" style="margin-top: 16px;">
        <view class="pp-stat"><text class="pp-stat-value">{{joinedCount}}</text><text class="pp-stat-label">已加入</text></view>
        <view class="pp-stat"><text class="pp-stat-value">{{playerCount}}</text><text class="pp-stat-label">总人数</text></view>
      </view>
    </view>

    <view class="pp-panel">
      <view class="pp-row-between">
        <text class="pp-section-title">成员</text>
        <text class="pp-chip">{{inviteCode}}</text>
      </view>
      <view class="pp-avatar-row" style="margin-top: 14px;">
        <view wx:for="{{joinedPlayers}}" wx:key="profileId" class="pp-avatar">
          <image wx:if="{{item.avatarUrl}}" class="pp-avatar" src="{{item.avatarUrl}}" mode="aspectFill"></image>
          <text wx:else>{{item.initial}}</text>
        </view>
        <view wx:for="{{emptySeats}}" wx:key="index" class="pp-avatar pp-avatar-empty">?</view>
      </view>
    </view>

    <view class="pp-action-row">
      <view class="pp-button pp-button-secondary" bindtap="handleRefreshTap"><image class="pp-icon" src="https://cdn.pomer.cn/static/party-pop-clean/icons/action-refresh.png" mode="aspectFit"></image><text>刷新成员</text></view>
      <view class="pp-button pp-button-lime" bindtap="handleInviteTap"><image class="pp-icon" src="https://cdn.pomer.cn/static/party-pop-clean/icons/action-add.png" mode="aspectFit"></image><text>继续邀请</text></view>
    </view>
    <view class="pp-list-item" bindtap="handleCodeTap">
      <view class="pp-list-copy"><text class="pp-list-title">查看邀请卡</text><text class="pp-caption">好友可通过口令加入同一场聚会。</text></view>
      <text class="pp-chip">口令</text>
    </view>
  </scroll-view>
  <view class="pp-fixed-actions">
    <view class="pp-button pp-button-primary" bindtap="handleStartTap">{{primaryActionLabel}}</view>
  </view>
  <pp-dialog state="{{__ppDialog}}" toast="{{__ppToast}}" loading="{{__ppLoading}}" bind:confirm="__handlePpDialogConfirm" bind:cancel="__handlePpDialogCancel"></pp-dialog>
</view>
