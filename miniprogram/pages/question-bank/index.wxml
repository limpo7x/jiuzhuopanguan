<navigation-bar
  title="换个问题"
  back="{{true}}"
  color="#24160f"
  background="rgba(255,253,248,0.96)"
  ext-class="question-bank-nav"
></navigation-bar>

<view class="question-bank-page">
  <scroll-view class="question-bank-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="question-bank-hero">
      <text class="question-bank-title">挑一题更合适的</text>
      <text class="question-bank-subtitle">这里只展示后台题库里已上线的题目，保存后台后前台会同步更新。</text>
    </view>

    <view wx:if="{{questions.length}}" class="question-bank-list">
      <view
        wx:for="{{questions}}"
        wx:key="id"
        class="question-bank-item {{item.active ? 'question-bank-item-active' : ''}}"
        data-id="{{item.id}}"
        bindtap="handleSelectTap"
      >
        <view class="question-bank-tag">{{item.tag}}</view>
        <text class="question-bank-text">{{item.text}}</text>
      </view>
    </view>

    <view wx:else class="question-bank-list">
      <view class="question-bank-item">
        <view class="question-bank-tag">暂无题目</view>
        <text class="question-bank-text">后台当前没有可用题目，请先在后台题库页上架后再使用。</text>
      </view>
    </view>

    <view class="question-bank-primary" bindtap="handleUseTap">使用这题继续</view>
  </scroll-view>
</view>
