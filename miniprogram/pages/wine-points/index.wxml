<navigation-bar
  title="积分中心"
  back="{{true}}"
  color="#24160f"
  background="rgba(255,253,248,0.96)"
  ext-class="points-nav"
></navigation-bar>

<view class="points-page">
  <scroll-view class="points-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="points-banner">
      <text class="points-value">{{balance}}</text>
      <text class="points-subtitle">可用积分</text>
      <image
        wx:if="{{bannerImageUrl}}"
        class="points-image"
        src="{{bannerImageUrl}}"
        mode="aspectFill"
        binderror="handleBannerImageError"
      ></image>
    </view>

    <view class="points-tab-row">
      <view
        wx:for="{{tabs}}"
        wx:key="id"
        class="points-tab-chip {{activeTab === item.id ? 'points-tab-chip-active' : ''}}"
        data-tab="{{item.id}}"
        bindtap="handleTabTap"
      >{{item.name}}</view>
    </view>

    <view wx:if="{{activeTab === 'tasks'}}">
      <view class="points-section-head">
        <text class="points-section-title">每日任务</text>
        <text class="points-section-link">积分明细</text>
      </view>

      <view wx:if="{{tasks.length}}" class="points-card">
        <view wx:for="{{tasks}}" wx:key="id" class="points-task-item">
          <view class="points-task-icon {{item.iconClass}}"></view>
          <view class="points-task-copy">
            <text class="points-task-title">{{item.title}}</text>
            <text class="points-task-meta">{{item.statusText}}</text>
          </view>
          <view
            class="points-tag {{item.canClaim ? 'points-tag-action' : 'points-tag-disabled'}} {{pendingActionId === item.id ? 'points-tag-pending' : ''}}"
            data-id="{{item.id}}"
            bindtap="handleTaskClaim"
          >{{pendingActionId === item.id ? '处理中' : item.buttonText}}</view>
        </view>
      </view>
      <view wx:else class="points-card">
        <view class="points-task-item">
          <view class="points-task-copy">
            <text class="points-task-title">暂无可领取任务</text>
            <text class="points-task-meta">当前仅保留首次登录奖励，更多任务待运营配置。</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{activeTab === 'mall'}}">
      <view class="points-section-head">
        <text class="points-section-title">积分奖励</text>
        <text class="points-section-link">兑换待开放</text>
      </view>

      <view wx:if="{{rewards.length}}" class="points-list">
        <view wx:for="{{rewards}}" wx:key="title" class="points-list-item">
          <view class="points-task-icon {{item.iconClass}}"></view>
          <view class="points-task-copy">
            <text class="points-task-title">{{item.title}}</text>
            <text class="points-task-meta">{{item.subtitle}}</text>
          </view>
          <view
            class="points-tag {{ownedRewardIds.indexOf(item.id) !== -1 ? 'points-tag-disabled' : 'points-tag-action'}} {{pendingActionId === item.id ? 'points-tag-pending' : ''}}"
            data-id="{{item.id}}"
            bindtap="handleRewardRedeem"
          >{{ownedRewardIds.indexOf(item.id) !== -1 ? '已兑换' : (pendingActionId === item.id ? '处理中' : (item.cost + ' 积分'))}}</view>
        </view>
      </view>
      <view wx:else class="points-list">
        <view class="points-list-item">
          <view class="points-task-copy">
            <text class="points-task-title">奖励兑换暂未开放</text>
            <text class="points-task-meta">没有真实权益和发放流水前，不展示可兑换商品。</text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>

