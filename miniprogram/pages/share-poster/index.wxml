<navigation-bar title="分享图" back="{{true}}" customBack="{{true}}" bind:back="handleBackTap" color="#111317" background="transparent" ext-class="pp-nav-page"></navigation-bar>
<view class="pp-page">
  <image class="pp-stage-bg" src="https://cdn.pomer.cn/static/party-pop-clean/app-bg-party-pop-390x844.png" mode="aspectFill"></image>
  <scroll-view class="pp-scroll share-poster-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="pp-poster-stage">
      <view class="pp-brand">
        <view class="pp-logo">记</view>
        <view class="pp-list-copy">
          <text class="pp-kicker">SHARE POSTER</text>
          <text class="pp-title-sm">{{canViewPosterContent ? '聚会分享图' : permissionTitle}}</text>
          <text class="pp-body">{{canViewPosterContent ? '照片、账本和时间线会合成一张分享图。' : permissionDescription}}</text>
        </view>
      </view>

      <view wx:if="{{canViewPosterContent}}" class="pp-timeline" style="margin-top: 18px;">
        <view wx:for="{{posterTimelineNodes}}" wx:key="id" class="pp-timeline-item">
          <text class="pp-caption">{{item.time}}</text>
          <image wx:if="{{item.type === 'photo' && item.imageUrl && !item.imageBroken}}" class="pp-cover" style="width: 100%; height: 150px; margin-top: 8px;" src="{{item.imageUrl}}" mode="aspectFill" data-id="{{item.id}}" bindload="handlePhotoImageLoad" binderror="handlePhotoImageError"></image>
          <text class="pp-list-title">{{item.title}}</text>
          <text class="pp-body">{{item.meta}}</text>
        </view>
        <view wx:if="{{!posterTimelineNodes.length}}" class="pp-empty"><text class="pp-body">暂无可保存节点，先去记录照片或账本变动。</text></view>
      </view>

      <view wx:if="{{canViewPosterContent}}" class="pp-panel pp-panel-lime share-poster-status-panel" style="margin-top: 18px;">
        <view class="share-poster-status-head"><text class="pp-section-title">{{displayTaskStatus}}</text></view>
        <view class="pp-action-row share-poster-action-row">
          <view class="pp-button pp-button-primary {{posterSaved || saveState === 'saving' || saveState === 'generating' ? 'pp-button-disabled' : ''}}" bindtap="handleSaveTap">{{savePosterLabel}}</view>
          <view class="pp-button pp-button-secondary" bindtap="handleTaskPrimaryTap">刷新状态</view>
          <view wx:if="{{saveState === 'failed' || (shareTask && (shareTask.status === 'failed' || shareTask.status === 'expired'))}}" class="pp-button pp-button-ghost" bindtap="handleTaskPrimaryTap">重新生成</view>
        </view>
        <text class="pp-caption share-poster-status-note">{{posterStatusLine}}</text>
      </view>

      <view wx:else class="pp-panel pp-panel-yellow" style="margin-top: 18px;">
        <text class="pp-section-title">{{permissionTitle}}</text>
        <text class="pp-body">{{permissionDescription}}</text>
        <view class="pp-action-row" style="margin-top: 14px;">
          <view class="pp-button pp-button-primary" bindtap="handlePermissionPrimaryTap">{{permissionPrimaryLabel}}</view>
          <view wx:if="{{permissionSecondaryLabel}}" class="pp-button pp-button-ghost" bindtap="handlePermissionSecondaryTap">{{permissionSecondaryLabel}}</view>
        </view>
      </view>

      <view wx:if="{{canViewPosterContent}}" class="pp-panel" style="margin-top: 18px;">
        <view class="pp-row-between"><text class="pp-section-title">小程序码</text><text class="pp-chip">{{qrCodeImageUrl ? '已生成' : '待生成'}}</text></view>
        <image wx:if="{{qrCodeImageUrl}}" class="pp-thumb" style="width: 116px; height: 116px; margin-top: 12px;" src="{{qrCodeImageUrl}}" mode="aspectFit"></image>
        <text wx:else class="pp-body">分享图生成后补齐小程序码。</text>
      </view>
    </view>
  </scroll-view>
  <view class="pp-fixed-actions share-poster-fixed-actions">
    <view class="pp-button pp-button-ghost" bindtap="handleExitShareTap">返回首页</view>
  </view>
  <canvas canvas-id="sharePosterCanvas" class="pp-hidden-canvas" style="width: {{canvasWidth}}px; height: {{canvasHeight}}px;"></canvas>
  <pp-dialog state="{{__ppDialog}}" toast="{{__ppToast}}" loading="{{__ppLoading}}" bind:confirm="__handlePpDialogConfirm" bind:cancel="__handlePpDialogCancel"></pp-dialog>
</view>
