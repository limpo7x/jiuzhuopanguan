<navigation-bar
  title="分享战报"
  back="{{true}}"
  customBack="{{true}}"
  bind:back="handleBackTap"
  color="#24160f"
  background="rgba(255,253,248,0.96)"
  ext-class="poster-nav"
></navigation-bar>

<view class="poster-page">
  <scroll-view class="poster-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="poster-card">
      <image wx:if="{{posterImageUrl}}" class="poster-image" src="{{posterImageUrl}}" mode="aspectFill"></image>
      <view class="poster-copy">
        <view class="poster-tag">{{sessionName}}</view>
        <text class="poster-headline">{{shareHeadline}}</text>
        <text class="poster-title">{{posterTitle}}</text>

        <view wx:if="{{featuredRank}}" class="poster-featured-rank">
          <view class="poster-featured-head">
            <view class="poster-featured-tag">{{featuredRank.title}}</view>
            <view class="poster-featured-badge">全场焦点</view>
          </view>
          <view class="poster-featured-body">
            <image class="poster-featured-avatar" src="{{featuredRank.avatarUrl}}" mode="aspectFill"></image>
            <view class="poster-featured-copy">
              <text class="poster-featured-name">{{featuredRank.name}}</text>
              <text class="poster-featured-value">{{featuredRank.value}}</text>
            </view>
          </view>
        </view>

        <view wx:if="{{secondaryRanks.length}}" class="poster-ranks">
          <view wx:for="{{secondaryRanks}}" wx:key="title" class="poster-rank-card">
            <view class="poster-rank-tag">{{item.title}}</view>
            <image class="poster-rank-avatar" src="{{item.avatarUrl}}" mode="aspectFill"></image>
            <text class="poster-rank-name">{{item.name}}</text>
            <text class="poster-rank-value">{{item.value}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="poster-section-head">
      <text class="poster-section-title">分享到</text>
    </view>

    <view class="poster-share-grid">
      <button wx:for="{{shareItems}}" wx:key="id" class="poster-share-item" open-type="share">
        <view class="poster-share-icon {{item.iconClass}}"></view>
        <text class="poster-share-label">{{item.name}}</text>
      </button>
    </view>

    <view class="poster-primary" bindtap="handleSaveTap">
      <text>保存战报分享图</text>
      <view class="poster-primary-icon"></view>
    </view>

    <view class="poster-primary" bindtap="handleCreateTap">
      <text>我也开一局</text>
      <view class="poster-primary-icon"></view>
    </view>

    <view class="poster-notice">
      <view class="poster-notice-icon"></view>
      <text>分享图仅保留展示数据，不包含按钮与操作入口</text>
    </view>
  </scroll-view>

  <canvas
    canvas-id="sharePosterCanvas"
    class="poster-hidden-canvas"
    style="width: {{canvasWidth}}px; height: {{canvasHeight}}px;"
  ></canvas>
</view>
