<navigation-bar title="闪享会员" back="{{true}}" color="#24160f" background="rgba(255,253,248,0.96)"></navigation-bar>

<view class="member-page">
  <scroll-view wx:if="{{membershipEnabled}}" class="member-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="member-hero">
      <text class="member-hero-title">开通会员，解锁完整酒局体验</text>
      <text class="member-hero-subtitle">会员权益、战报、分享素材统一读取后台会员配置。</text>
    </view>

    <view class="member-card">
      <text class="member-section-title">会员权益</text>
      <view wx:for="{{benefits}}" wx:key="label" class="member-benefit-row">
        <text class="member-benefit-label">{{item.label}}</text>
        <text class="member-benefit-value">{{item.value}}</text>
      </view>
    </view>

    <view class="member-card">
      <text class="member-section-title">可选方案</text>
      <view wx:for="{{packages}}" wx:key="name" class="member-package {{item.active ? 'member-package-active' : ''}}">
        <text class="member-package-name">{{item.name}}</text>
        <text class="member-package-price">{{item.price}}</text>
      </view>
    </view>

    <view class="member-primary" bindtap="handleOpenTap">{{ctaText}}</view>
  </scroll-view>

  <view wx:else class="member-disabled">
    <view class="member-disabled-text">闪享会员已关闭，当前入口不对外开放。</view>
  </view>
</view>
