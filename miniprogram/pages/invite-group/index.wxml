<navigation-bar
  title="邀请好友"
  back="{{true}}"
  color="#24160f"
  background="rgba(255,253,248,0.96)"
  ext-class="invite-nav"
></navigation-bar>

<view class="invite-page">
  <scroll-view class="invite-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="invite-progress">
      <view class="invite-progress-step invite-progress-step-done">
        <text class="invite-progress-dot">1</text>
        <text>创建酒局</text>
      </view>
      <view class="invite-progress-step invite-progress-step-done">
        <text class="invite-progress-dot">2</text>
        <text>玩法设置</text>
      </view>
      <view class="invite-progress-step invite-progress-step-active">
        <text class="invite-progress-dot">3</text>
        <text>邀请开局</text>
      </view>
    </view>

    <view class="invite-center">
      <view class="invite-goblet-icon invite-icon-goblet"></view>
      <text class="invite-title">邀请好友加入</text>
      <text class="invite-subtitle">{{sessionName}}</text>
    </view>

    <view class="invite-card invite-form-card">
      <text class="invite-label">预览邀请卡</text>
      <view class="invite-primary" bindtap="handlePreviewTap">
        <view class="invite-primary-icon invite-icon-wechat"></view>
        <text>先看分享页</text>
      </view>
    </view>

    <view class="invite-card invite-form-card invite-copy-card">
      <text class="invite-label">复制邀请码</text>
      <view class="invite-row-between">
        <text class="invite-code">{{inviteCode || '生成中'}}</text>
        <view class="invite-tag" bindtap="handleCopyTap">复制</view>
      </view>
    </view>

    <view class="invite-share-grid">
      <button wx:for="{{shareItems}}" wx:key="id" class="invite-share-item" open-type="share">
        <view class="invite-share-icon {{item.iconClass}}"></view>
        <text class="invite-share-label">{{item.name}}</text>
      </button>
    </view>

    <view class="invite-primary invite-primary-full" bindtap="handleNextTap">
      <text>我已发送，去等大家</text>
      <view class="invite-primary-icon invite-icon-arrow"></view>
    </view>
  </scroll-view>
</view>
