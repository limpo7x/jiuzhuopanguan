<navigation-bar
  title="邀请好友"
  back="{{true}}"
  customBack="{{true}}"
  bind:back="handleBackTap"
  color="#111827"
  background="rgba(255,255,252,0.96)"
  ext-class="invite-nav"
></navigation-bar>

<view class="invite-page invite-redesign">
  <scroll-view class="invite-scroll invite-redesign-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="invite-hero">
      <text class="invite-title">邀请好友</text>
    </view>

    <view class="invite-code-card">
      <image
        class="invite-code-card-image"
        src="/assets/party-recorder/pr-cs008aq-invite-paper-mobile-750w-no-checkerboard.png"
        mode="widthFix"
      ></image>
      <view class="invite-code-content">
        <text class="invite-code-label">房间码</text>
        <text class="invite-code">{{inviteCode || '生成中'}}</text>
        <text class="invite-code-expire">{{joinStatusText}}</text>

        <view class="invite-avatar-slots">
          <view
            wx:for="{{avatarSlots}}"
            wx:key="id"
            class="invite-avatar-slot {{item.filled ? 'invite-avatar-slot-filled' : ''}}"
          >
            <image wx:if="{{item.avatarUrl}}" class="invite-avatar-image" src="{{item.avatarUrl}}" mode="aspectFill"></image>
            <text wx:elif="{{item.filled}}" class="invite-avatar-initial">{{item.initial}}</text>
            <text wx:else class="invite-avatar-empty">+</text>
          </view>
        </view>
      </view>
    </view>

    <view class="invite-inline-actions">
      <view class="invite-inline-action" bindtap="handleCopyTap">复制口令</view>
      <view class="invite-inline-action" bindtap="handleRefreshTap">刷新状态</view>
    </view>

    <button class="invite-share-button" open-type="share">
      <view class="invite-share-button-icon invite-icon-wechat"></view>
      <text>分享给好友</text>
    </button>
  </scroll-view>

  <canvas
    canvas-id="inviteShareCardCanvas"
    class="invite-share-card-canvas"
    style="width: 500px; height: 400px;"
  ></canvas>

  <view class="invite-bottom-bar">
    <view class="invite-primary invite-primary-full party-cta party-cta-primary" bindtap="handleNextTap">
      <text>拍第一张</text>
    </view>
    <view class="invite-secondary-full party-cta party-cta-tertiary" bindtap="handleCopyTap">
      <text>复制口令</text>
    </view>
  </view>
</view>
