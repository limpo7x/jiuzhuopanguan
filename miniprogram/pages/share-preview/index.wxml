<navigation-bar title="{{shareArchiveMode ? '分享预览' : '邀请预览'}}" back="{{true}}" customBack="{{true}}" bind:back="handleBackTap" color="#111317" background="transparent" ext-class="pp-nav-page"></navigation-bar>
<view class="pp-page">
  <image class="pp-stage-bg" src="https://cdn.pomer.cn/static/party-pop-clean/stage-bg-390x844.png" mode="aspectFill"></image>
  <scroll-view class="pp-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="pp-hero pp-panel-cyan">
      <text class="pp-kicker">{{sessionName || '聚会记录师'}}</text>
      <text class="pp-title">{{previewTitle}}</text>
      <text class="pp-body">{{previewBody}}</text>
      <text wx:if="{{!shareArchiveMode}}" class="pp-code" style="margin-top: 16px;">{{inviteCode || '------'}}</text>
      <text class="pp-caption" style="margin-top: 10px;">{{inviteStatusText}}</text>
    </view>
    <view wx:if="{{errorText}}" class="pp-empty"><text class="pp-section-title">分享页暂时无法展示</text><text class="pp-body">{{errorText}}</text><view class="pp-button pp-button-secondary" bindtap="handleRetryTap">重试</view></view>
    <view wx:else class="pp-stack">
      <view class="pp-panel">
        <text class="pp-section-title">这场聚会的回忆</text>
        <view wx:if="{{keyEvents.length}}" class="pp-timeline" style="margin-top: 14px;">
          <view wx:for="{{keyEvents}}" wx:key="id" class="pp-timeline-item"><text class="pp-list-title">{{item.title}}</text><text class="pp-body">{{item.detail}}</text></view>
        </view>
        <text wx:else class="pp-body">好友加入后再查看回忆。</text>
      </view>
      <view class="pp-panel pp-panel-lime">
        <text class="pp-section-title">隐私保护</text>
        <text class="pp-body">仅展示可分享内容，私密内容不会进入公开页。</text>
      </view>
    </view>
  </scroll-view>
  <view wx:if="{{shareArchiveMode}}" class="pp-fixed-actions"><view class="pp-button pp-button-ghost" bindtap="handleReturnHomeTap">返回首页</view><view class="pp-button pp-button-primary" bindtap="handleReturnAlbumTap">查看相册</view></view>
  <view wx:else class="pp-fixed-actions"><view class="pp-button pp-button-ghost" bindtap="handleCopyInviteCodeTap">复制口令</view><view class="pp-button pp-button-primary" bindtap="handleJoinSessionTap">{{joinActionLabel}}</view></view>
  <pp-dialog state="{{__ppDialog}}" toast="{{__ppToast}}" loading="{{__ppLoading}}" bind:confirm="__handlePpDialogConfirm" bind:cancel="__handlePpDialogCancel"></pp-dialog>
</view>
