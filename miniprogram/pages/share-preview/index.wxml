<view class="share-page">
  <scroll-view class="share-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="share-chip-row">
      <view class="share-chip {{!showJoinStatus ? 'share-chip-active' : ''}}" data-tab="preview" bindtap="handleTabTap">é‚€è¯·å¡é¢„è§ˆ</view>
      <view class="share-chip {{showJoinStatus ? 'share-chip-active' : ''}}" data-tab="status" bindtap="handleTabTap">åŠ å…¥çŠ¶æ€?/view>
    </view>

    <view wx:if="{{!showJoinStatus}}" class="share-poster-card">
      <image wx:if="{{previewImageUrl}}" class="share-poster-image" src="{{previewImageUrl}}" mode="aspectFill"></image>
      <view class="share-poster-copy">
        <text class="share-poster-title">{{shareHeadline}}</text>
        <text class="share-poster-subtitle">{{previewTitle}}</text>
        <text class="share-poster-session">{{sessionName}}</text>
        <view class="share-poster-row">
          <view class="share-avatar-stack">
            <image wx:for="{{avatars}}" wx:key="index" class="share-avatar" src="{{item}}" mode="aspectFill"></image>
          </view>
          <text class="share-poster-count">{{joinedCount}}/{{playerCount}} äººå·²åŠ å…¥</text>
        </view>
        <view class="share-code-box">{{inviteCode}}</view>
      </view>
    </view>

    <view wx:else class="share-poster-card">
      <view class="share-poster-copy">
        <text class="share-poster-title">{{shareHeadline}}</text>
        <text class="share-poster-subtitle">é‚€è¯·å£ä»?{{inviteCode}}ï¼Œå½“å‰?{{joinedCount}}/{{playerCount}} äººå·²åŠ å…¥</text>
        <view class="share-status-list">
          <view wx:for="{{joinStatusPlayers}}" wx:key="name" class="share-status-item">
            <view class="share-status-user">
              <image class="share-avatar" src="{{item.avatarUrl}}" mode="aspectFill"></image>
              <text class="share-status-name">{{item.name}}</text>
            </view>
            <text class="share-status-tag">{{item.status}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="share-section-head">
      <text class="share-section-title">å¯åˆ†äº«åˆ°</text>
    </view>

    <view class="share-grid">
      <button wx:for="{{shareItems}}" wx:key="id" class="share-item" open-type="share">
        <view class="share-item-icon {{item.iconClass}}"></view>
        <text class="share-item-label">{{item.name}}</text>
      </button>
    </view>

    <view class="share-primary {{isGeneratingPoster ? 'share-primary-disabled' : ''}}" bindtap="handleSaveTap">
      <text>{{isGeneratingPoster ? '·ÖÏíÍ¼Éú³ÉÖĞ' : '±£´æ·ÖÏíÍ¼'}}</text>
      <view class="share-primary-icon"></view>
    </view>
  </scroll-view>

  <canvas
    type="2d"
    canvas-id="sharePreviewCanvas"
    class="share-hidden-canvas"
    style="width: {{canvasWidth}}px; height: {{canvasHeight}}px;"
  ></canvas>
</view>
