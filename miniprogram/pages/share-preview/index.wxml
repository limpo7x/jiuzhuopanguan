<navigation-bar
  title="邀请海报"
  back="{{true}}"
  color="#24160f"
  background="rgba(255,253,248,0.96)"
  ext-class="share-nav"
></navigation-bar>

<view class="share-page">
  <scroll-view class="share-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="share-tabs">
      <view class="share-chip {{!showJoinStatus ? 'share-chip-active' : ''}}" data-tab="preview" bindtap="handleTabTap">邀请预览</view>
      <view class="share-chip {{showJoinStatus ? 'share-chip-active' : ''}}" data-tab="status" bindtap="handleTabTap">口令加入状态</view>
    </view>

    <view wx:if="{{!showJoinStatus}}" class="share-poster-card">
      <view class="share-poster-copy">
        <text class="share-poster-title">这局快乐就完事了！</text>
        <text class="share-poster-subtitle">{{sessionName}}</text>
        <view class="share-poster-row">
          <view class="share-code-block">
            <text class="share-code-label">加入口令</text>
            <view class="share-code-box">{{inviteCode || '未生成'}}</view>
          </view>
          <text class="share-poster-count">{{joinedCount}}/{{playerCount}} 已加入</text>
        </view>
      </view>
    </view>

    <view wx:else class="share-poster-card">
      <view class="share-poster-copy">
        <text class="share-poster-title">口令加入状态</text>
        <text class="share-poster-subtitle">邀请码 {{inviteCode || '未生成'}} · 当前 {{joinedCount}}/{{playerCount}} 已加入</text>
        <view class="share-status-list">
          <view wx:for="{{joinStatusPlayers}}" wx:key="name" class="share-status-item">
            <image wx:if="{{item.avatarUrl}}" class="share-status-avatar" src="{{item.avatarUrl}}" mode="aspectFill"></image>
            <view wx:else class="share-status-avatar"></view>
            <text class="share-status-name">{{item.name}}</text>
            <view class="share-status-tag">{{item.status}}</view>
          </view>
        </view>
      </view>
    </view>

    <view class="share-action-grid">
      <button wx:for="{{shareItems}}" wx:key="id" class="share-action-item" open-type="share" data-id="{{item.id}}" bindtap="handleShareTap">
        <view class="share-action-icon {{item.iconClass}}"></view>
        <text class="share-action-label">{{item.name}}</text>
      </button>
    </view>

    <view class="share-primary" bindtap="handleSaveTap">
      <text>保存海报</text>
      <view class="share-primary-icon"></view>
    </view>
  </scroll-view>

  <canvas
    canvas-id="sharePreviewCanvas"
    class="share-hidden-canvas"
    style="width: {{canvasWidth}}px; height: {{canvasHeight}}px;"
  ></canvas>
</view>
