<navigation-bar title="设置" back="{{true}}" customBack="{{true}}" bind:back="handleBackTap" color="#111317" background="transparent" ext-class="pp-nav-page"></navigation-bar>
<view class="pp-page">
  <image class="pp-stage-bg" src="https://cdn.pomer.cn/static/party-pop-clean/stage-bg-390x844.png" mode="aspectFill"></image>
  <scroll-view class="pp-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="pp-hero pp-panel-lime"><text class="pp-kicker">SETTINGS</text><text class="pp-title">设置</text><text class="pp-body">管理资料、隐私、通知和数据。</text></view>
    <view wx:if="{{items.length}}" class="pp-list"><view wx:for="{{items}}" wx:key="title" class="pp-list-item"><view class="pp-list-copy"><text class="pp-list-title">{{item.title}}</text><text class="pp-caption">{{item.desc}}</text></view><text class="pp-chip">{{item.status || '设置'}}</text></view></view>
    <view wx:else class="pp-empty"><text class="pp-section-title">暂无可配置项</text><text class="pp-body">后续设置会按真实配置展示。</text></view>
  </scroll-view>
  <pp-dialog state="{{__ppDialog}}" toast="{{__ppToast}}" loading="{{__ppLoading}}" bind:confirm="__handlePpDialogConfirm" bind:cancel="__handlePpDialogCancel"></pp-dialog>
</view>
