<navigation-bar title="{{pageTitle}}" back="{{true}}" customBack="{{true}}" bind:back="handleBackTap" color="#111317" background="transparent" ext-class="pp-nav-page"></navigation-bar>
<view class="pp-page">
  <image class="pp-stage-bg" src="https://cdn.pomer.cn/static/party-pop-clean/stage-bg-390x844.png" mode="aspectFill"></image>
  <scroll-view class="pp-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="pp-hero">
      <text class="pp-kicker">MEMORIES</text>
      <text class="pp-title">{{pageTitle || '我的相册'}}</text>
      <text class="pp-body">按进行中和已结束整理你的聚会记录。</text>
      <view class="pp-stat-row" style="margin-top: 16px;">
        <view class="pp-stat"><text class="pp-stat-value">{{totalCount}}</text><text class="pp-stat-label">全部</text></view>
        <view class="pp-stat"><text class="pp-stat-value">{{ongoingCount}}</text><text class="pp-stat-label">进行中</text></view>
        <view class="pp-stat"><text class="pp-stat-value">{{endedCount}}</text><text class="pp-stat-label">已结束</text></view>
      </view>
    </view>
    <view class="pp-tabs">
      <view class="pp-tab {{activeRecordFilter === 'all' ? 'pp-tab-active' : ''}}" data-filter="all" bindtap="handleFilterTap">全部</view>
      <view class="pp-tab {{activeRecordFilter === 'ongoing' ? 'pp-tab-active' : ''}}" data-filter="ongoing" bindtap="handleFilterTap">进行中</view>
      <view class="pp-tab {{activeRecordFilter === 'ended' ? 'pp-tab-active' : ''}}" data-filter="ended" bindtap="handleFilterTap">已结束</view>
    </view>
    <view wx:if="{{loading}}" class="pp-loading"><view class="pp-loading-dot"></view><text>正在整理聚会记录</text></view>
    <view wx:elif="{{items.length}}" class="pp-list">
      <view wx:for="{{items}}" wx:key="id" class="pp-list-item" data-session-id="{{item.sessionId}}" data-brief-id="{{item.briefId}}" data-state-type="{{item.stateType}}" data-share-image-url="{{item.shareImageUrl}}" data-route="{{item.route}}" bindtap="handleItemTap">
        <image wx:if="{{item.coverUrl}}" class="pp-thumb" style="width: 92px; height: 82px;" src="{{item.coverUrl}}" mode="aspectFill" bindload="handleCoverLoad" binderror="handleCoverError"></image>
        <image wx:else class="pp-thumb" style="width: 92px; height: 82px;" src="https://cdn.pomer.cn/static/party-pop-clean/home-hero-750x420.png" mode="aspectFill"></image>
        <view class="pp-list-copy"><text class="pp-list-title">{{item.title}}</text><text class="pp-caption">{{item.meta}}</text></view>
        <text class="pp-chip">{{item.statusText}}</text>
      </view>
    </view>
    <view wx:else class="pp-empty"><image class="pp-empty-sticker" src="https://cdn.pomer.cn/static/party-pop-clean/empty-memory-sticker.png" mode="aspectFit"></image><text class="pp-section-title">{{emptyText}}</text><view class="pp-button pp-button-primary" bindtap="handleCreateTap">去创建聚会</view></view>
  </scroll-view>

<view class="pp-bottom-nav">
  <view class="pp-bottom-item " data-tab="home" bindtap="handleBottomTabTap">
    <image class="pp-bottom-icon" src="https://cdn.pomer.cn/static/party-pop-clean/icons/tab-home.png" mode="aspectFit"></image>
    <text>首页</text>
  </view>
  <view class="pp-bottom-item " data-tab="tools" bindtap="handleBottomTabTap">
    <image class="pp-bottom-icon" src="https://cdn.pomer.cn/static/party-pop-clean/icons/tab-tools.png" mode="aspectFit"></image>
    <text>工具箱</text>
  </view>
  <view class="pp-bottom-item " data-tab="rankings" bindtap="handleBottomTabTap">
    <image class="pp-bottom-icon" src="https://cdn.pomer.cn/static/party-pop-clean/icons/tab-rank.png" mode="aspectFit"></image>
    <text>排行榜</text>
  </view>
  <view class="pp-bottom-item pp-bottom-item-active" data-tab="me" bindtap="handleBottomTabTap">
    <image class="pp-bottom-icon" src="https://cdn.pomer.cn/static/party-pop-clean/icons/tab-me-active.png" mode="aspectFit"></image>
    <text>我的</text>
  </view>
</view>
  <pp-dialog state="{{__ppDialog}}" toast="{{__ppToast}}" loading="{{__ppLoading}}" bind:confirm="__handlePpDialogConfirm" bind:cancel="__handlePpDialogCancel"></pp-dialog>
</view>
