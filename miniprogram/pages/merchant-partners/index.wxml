<navigation-bar
  title="合作商户"
  back="{{true}}"
  color="#24160f"
  background="rgba(255,253,248,0.96)"
  ext-class="merchant-nav"
></navigation-bar>

<view class="merchant-page">
  <scroll-view class="merchant-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="merchant-head-row">
      <text class="merchant-title">商户合作</text>
    </view>

    <view class="merchant-banner">
      <text class="merchant-banner-title">合作优惠待配置</text>
      <text class="merchant-banner-meta">没有真实商户和核销合同前，不开放领取或核销。</text>
    </view>

    <view wx:if="{{categories.length}}" class="merchant-grid">
      <view wx:for="{{categories}}" wx:key="name" class="merchant-tile {{item.toneClass}}">
        <view class="merchant-tile-icon {{item.iconClass}}"></view>
        <text class="merchant-tile-label">{{item.name}}</text>
      </view>
    </view>

    <view class="merchant-section-head">
      <text class="merchant-section-title">精选商户</text>
    </view>

    <view wx:if="{{shops.length}}" class="merchant-list">
      <view wx:for="{{shops}}" wx:key="id" class="merchant-item">
        <view class="merchant-thumb">
          <image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill"></image>
        </view>
        <view class="merchant-copy">
          <text class="merchant-item-title">{{item.name}}</text>
          <text class="merchant-item-meta">{{item.meta}}</text>
        </view>
        <view class="merchant-tag">{{item.status}}</view>
      </view>
    </view>
    <view wx:else class="merchant-notice">
      <view class="merchant-notice-icon"></view>
      <text>暂无已验证商户优惠，当前仅保留合作入口占位。</text>
    </view>

    <view class="merchant-section-head">
      <text class="merchant-section-title">安全返程</text>
    </view>

    <view wx:if="{{safeBack.length}}" class="merchant-grid">
      <view wx:for="{{safeBack}}" wx:key="name" class="merchant-tile {{item.toneClass}}">
        <view class="merchant-tile-icon {{item.iconClass}}"></view>
        <text class="merchant-tile-label">{{item.name}}</text>
      </view>
    </view>

    <view class="merchant-notice">
      <view class="merchant-notice-icon"></view>
      <text>{{notice || '当前页面仅展示已接入后台的商户权益。'}}</text>
    </view>
  </scroll-view>
</view>
