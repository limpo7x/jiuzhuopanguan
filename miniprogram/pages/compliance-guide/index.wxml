<navigation-bar
  title="新手引导"
  back="{{true}}"
  color="#24160f"
  background="rgba(255,253,248,0.96)"
  ext-class="guide-nav"
></navigation-bar>

<view class="guide-page">
  <scroll-view class="guide-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="guide-chip-row">
      <view class="guide-chip">新手引导</view>
      <view class="guide-chip guide-chip-active">合规提示</view>
    </view>

    <view class="guide-center">
      <text class="guide-title">理性饮酒 快乐为主</text>
    </view>

    <view class="guide-list">
      <view wx:for="{{items}}" wx:key="title" class="guide-list-item">
        <view class="guide-task-icon {{item.iconClass}}"></view>
        <view class="guide-list-copy">
          <text class="guide-list-title">{{item.title}}</text>
          <text class="guide-list-meta">{{item.meta}}</text>
        </view>
      </view>
    </view>

    <view class="guide-primary" bindtap="handleConfirmTap">
      <text>我知道了</text>
      <view class="guide-primary-icon"></view>
    </view>
  </scroll-view>
</view>
