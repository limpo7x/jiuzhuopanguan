<navigation-bar title="新手引导" back="{{false}}" customBack="{{false}}" bind:back="handleBackTap" color="#111317" background="transparent" ext-class="pp-nav-page"></navigation-bar>
<view class="pp-page">
  <image class="pp-stage-bg" src="https://cdn.pomer.cn/static/party-pop-clean/stage-bg-390x844.png" mode="aspectFill"></image>
  <scroll-view class="pp-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="pp-hero pp-panel-cyan"><text class="pp-kicker">GUIDE</text><text class="pp-title">新手引导</text><text class="pp-body">理性聚会，快乐为主，记录真实回忆。</text></view>
    <view class="pp-list"><view wx:for="{{items}}" wx:key="title" class="pp-list-item"><image class="pp-icon-lg" src="{{item.iconUrl}}" mode="aspectFit"></image><view class="pp-list-copy"><text class="pp-list-title">{{item.title}}</text><text class="pp-caption">{{item.desc}}</text></view></view></view>
  </scroll-view>
  <view class="pp-fixed-actions"><view class="pp-button pp-button-primary" bindtap="handleConfirmTap">我知道了</view></view>
  <pp-dialog state="{{__ppDialog}}" toast="{{__ppToast}}" loading="{{__ppLoading}}" bind:confirm="__handlePpDialogConfirm" bind:cancel="__handlePpDialogCancel"></pp-dialog>
</view>
