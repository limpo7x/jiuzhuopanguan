<navigation-bar
  title="工具箱"
  back="{{false}}"
  color="#24160f"
  background="rgba(255,253,248,0.96)"
  ext-class="tools-nav"
></navigation-bar>

<view class="tools-page">
  <scroll-view class="tools-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="tools-search">
      <view class="tools-search-icon tools-icon-search"></view>
      <text class="tools-search-text">搜索工具</text>
      <view class="tools-search-focus tools-icon-focus"></view>
    </view>

    <view class="tools-hero">
      <image class="tools-hero-image" src="/assets/home/toolbox-hero.png" mode="aspectFill"></image>
      <view class="tools-hero-mask"></view>
      <view class="tools-hero-content">
        <text class="tools-hero-title">工具在手 生活不愁</text>
        <text class="tools-hero-subtitle">高效 · 实用 · 有趣</text>
      </view>
    </view>

    <view class="tools-chip-row">
      <view
        wx:for="{{categories}}"
        wx:key="id"
        class="tools-chip {{item.active ? 'tools-chip-active' : ''}}"
      >{{item.name}}</view>
    </view>

    <view class="tools-section-head">
      <text class="tools-section-title">热门工具</text>
    </view>

    <view class="tools-grid">
      <view
        wx:for="{{popularTools}}"
        wx:key="id"
        class="tools-tile {{item.toneClass}}"
        data-id="{{item.id}}"
        data-name="{{item.name}}"
        bindtap="handleToolTap"
      >
        <view class="tools-tile-icon">
          <view class="tools-tile-glyph {{item.iconClass}}"></view>
        </view>
        <text class="tools-tile-label">{{item.name}}</text>
      </view>
    </view>

    <view class="tools-section-head">
      <text class="tools-section-title">工具分类</text>
    </view>

    <view class="tools-list">
      <view
        wx:for="{{toolCategories}}"
        wx:key="id"
        class="tools-list-item"
        data-id="{{item.id}}"
        data-name="{{item.name}}"
        bindtap="handleToolTap"
      >
        <view class="tools-list-thumb">
          <image src="{{item.imageUrl}}" mode="aspectFill"></image>
        </view>
        <view class="tools-list-copy">
          <text class="tools-list-title">{{item.name}}</text>
          <text class="tools-list-meta">{{item.meta}}</text>
        </view>
        <text class="tools-list-arrow">›</text>
      </view>
    </view>
  </scroll-view>

  <view class="tools-tabbar">
    <view class="tools-tab-item" data-tab="home" bindtap="handleTabTap">
      <view class="tools-tab-icon tools-nav-home"></view>
      <text class="tools-tab-label">首页</text>
    </view>
    <view class="tools-tab-item tools-tab-active" data-tab="tools" bindtap="handleTabTap">
      <view class="tools-tab-icon tools-nav-tools tools-nav-active"></view>
      <text class="tools-tab-label">工具箱</text>
    </view>
    <view class="tools-tab-item" data-tab="judge" bindtap="handleTabTap">
      <view class="tools-tab-icon tools-nav-judge"></view>
      <text class="tools-tab-label">酒桌判官</text>
    </view>
    <view class="tools-tab-item" data-tab="me" bindtap="handleTabTap">
      <view class="tools-tab-icon tools-nav-me"></view>
      <text class="tools-tab-label">我的</text>
    </view>
  </view>
</view>
