<navigation-bar
  title="工具箱"
  back="{{false}}"
  color="#24160f"
  background="rgba(255,253,248,0.96)"
  ext-class="tools-nav"
></navigation-bar>

<view class="tools-page">
  <scroll-view class="tools-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="tools-search">
      <view class="tools-search-icon tools-icon-search"></view>
      <input
        class="tools-search-input"
        type="text"
        value="{{searchKeyword}}"
        placeholder="搜索工具"
        placeholder-class="tools-search-placeholder"
        confirm-type="search"
        bindinput="handleSearchInput"
      />
      <view
        wx:if="{{searchKeyword}}"
        class="tools-search-clear"
        bindtap="handleSearchClear"
      >清空</view>
      <view wx:else class="tools-search-focus tools-icon-focus"></view>
    </view>

    <view class="tools-hero">
      <image wx:if="{{heroImageUrl}}" class="tools-hero-image" src="{{heroImageUrl}}" mode="aspectFill"></image>
      <view class="tools-hero-mask"></view>
      <view class="tools-hero-content">
        <text class="tools-hero-title">{{heroTitle}}</text>
        <text class="tools-hero-subtitle">{{heroSubtitle}}</text>
      </view>
    </view>

    <view class="tools-chip-row">
      <view
        wx:for="{{categories}}"
        wx:key="id"
        class="tools-chip {{item.active ? 'tools-chip-active' : ''}}"
        data-id="{{item.id}}"
        bindtap="handleCategoryTap"
      >{{item.name}}</view>
    </view>

    <block wx:if="{{activeCategory === 'all'}}">
      <view class="tools-section-head">
        <text class="tools-section-title">热门工具</text>
      </view>

      <view class="tools-grid">
        <view
          wx:for="{{popularTools}}"
          wx:key="id"
          class="tools-tile {{item.toneClass}}"
          data-id="{{item.id}}"
          data-name="{{item.name}}"
          bindtap="handleToolTap"
        >
          <view class="tools-tile-icon">
            <image wx:if="{{item.imageUrl}}" class="tools-tile-image" lazy-load="true" src="{{item.imageUrl}}" mode="aspectFill"></image>
          </view>
          <text class="tools-tile-label">{{item.name}}</text>
        </view>
      </view>
      <view wx:if="{{!popularTools.length}}" class="tools-empty">
        <text class="tools-empty-title">没有匹配工具</text>
        <text class="tools-empty-meta">请切换分类，或更换关键词。</text>
      </view>

      <view class="tools-section-head">
        <text class="tools-section-title">工具分类</text>
      </view>

      <view class="tools-list">
        <view
          wx:for="{{categoryCards}}"
          wx:key="id"
          class="tools-list-item"
          data-id="{{item.id}}"
          bindtap="handleCategoryTap"
        >
          <view class="tools-list-thumb">
            <image wx:if="{{item.imageUrl}}" lazy-load="true" src="{{item.imageUrl}}" mode="aspectFill"></image>
          </view>
          <view class="tools-list-copy">
            <text class="tools-list-title">{{item.name}}</text>
            <text class="tools-list-meta">{{item.meta}}</text>
          </view>
          <text class="tools-list-arrow">&gt;</text>
        </view>
      </view>
      <view wx:if="{{!categoryCards.length}}" class="tools-empty tools-empty-soft">
        <text class="tools-empty-meta">当前没有分类结果。</text>
      </view>
    </block>

    <block wx:else>
      <view class="tools-section-head">
        <text class="tools-section-title">{{activeCategoryName}}</text>
      </view>

      <view class="tools-list">
        <view
          wx:for="{{filteredTools}}"
          wx:key="id"
          class="tools-list-item"
          data-id="{{item.id}}"
          data-name="{{item.name}}"
          bindtap="handleToolTap"
        >
          <view class="tools-list-thumb">
            <image wx:if="{{item.imageUrl}}" lazy-load="true" src="{{item.imageUrl}}" mode="aspectFill"></image>
          </view>
          <view class="tools-list-copy">
            <text class="tools-list-title">{{item.name}}</text>
            <text class="tools-list-meta">{{item.meta}}</text>
          </view>
          <text class="tools-list-arrow">&gt;</text>
        </view>
      </view>
      <view wx:if="{{!filteredTools.length}}" class="tools-empty tools-empty-soft">
        <text class="tools-empty-meta">当前分类下暂无工具。</text>
      </view>
    </block>
  </scroll-view>

  <view class="tools-tabbar">
    <view class="tools-tab-item" data-tab="home" bindtap="handleTabTap">
      <view class="tools-tab-icon tools-nav-home"></view>
      <text class="tools-tab-label">首页</text>
    </view>
    <view class="tools-tab-item tools-tab-active" data-tab="tools" bindtap="handleTabTap">
      <view class="tools-tab-icon tools-nav-tools tools-nav-active"></view>
      <text class="tools-tab-label">工具箱</text>
    </view>
    <view class="tools-tab-item" data-tab="judge" bindtap="handleTabTap">
      <view class="tools-tab-icon tools-nav-judge"></view>
      <text class="tools-tab-label">酒桌判官</text>
    </view>
    <view class="tools-tab-item" data-tab="me" bindtap="handleTabTap">
      <view class="tools-tab-icon tools-nav-me"></view>
      <text class="tools-tab-label">我的</text>
    </view>
  </view>
</view>
