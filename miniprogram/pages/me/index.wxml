<navigation-bar
  title="我的"
  back="{{false}}"
  color="#24160f"
  background="rgba(255,253,248,0.96)"
  ext-class="me-nav"
></navigation-bar>

<view class="me-page">
  <scroll-view class="me-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="me-profile-row">
      <view class="me-user">
        <image class="me-avatar" src="{{currentProfile.avatarUrl}}" mode="aspectFill"></image>
        <view class="me-user-copy">
          <view class="me-name-row">
            <text class="me-name">{{currentProfile.name}}</text>
            <view class="me-vip-tag">V1</view>
          </view>
          <text class="me-id">手机号: {{currentProfile.phoneMasked || '未绑定'}}</text>
          <text class="me-id">微信ID: {{currentProfile.wechatOpenId || currentProfile.id}}</text>
        </view>
      </view>
      <view class="me-edit-btn" bindtap="handleEditTap">{{currentProfile.phone ? '编辑资料' : '微信登录'}}</view>
    </view>

    <view class="me-member-card">
      <view class="me-member-top">
        <text class="me-member-title">闪享会员</text>
        <view class="me-member-btn" bindtap="handleMemberTap">立即开通</view>
      </view>
      <text class="me-member-desc">尊享每月畅玩 6 大权益</text>
    </view>

    <view class="me-stat-row">
      <view
        wx:for="{{assetStats}}"
        wx:key="label"
        class="me-stat-item"
        data-label="{{item.label}}"
        bindtap="handleAssetTap"
      >
        <text class="me-stat-value">{{item.value}}</text>
        <text class="me-stat-label">{{item.label}}</text>
      </view>
    </view>

    <view class="me-section-head">
      <text class="me-section-title">我的酒局</text>
      <text class="me-section-link" data-label="我的聚友" bindtap="handleWineStatTap">好友管理</text>
    </view>

    <view class="me-stat-row">
      <view wx:for="{{wineStats}}" wx:key="label" class="me-stat-item" data-label="{{item.label}}" bindtap="handleWineStatTap">
        <text class="me-stat-value">{{item.value}}</text>
        <text class="me-stat-label">{{item.label}}</text>
      </view>
    </view>

    <view class="me-section-head">
      <text class="me-section-title">常用功能</text>
    </view>

    <view class="me-grid">
      <view
        wx:for="{{features}}"
        wx:key="id"
        class="me-tile"
        data-name="{{item.name}}"
        bindtap="handleFeatureTap"
      >
        <view class="me-tile-icon">
          <view class="me-tile-glyph {{item.iconClass}}"></view>
        </view>
        <text class="me-tile-label">{{item.name}}</text>
      </view>
    </view>
  </scroll-view>

  <view class="me-tabbar">
    <view class="me-tab-item" data-tab="home" bindtap="handleTabTap">
      <view class="me-tab-icon me-nav-home"></view>
      <text class="me-tab-label">首页</text>
    </view>
    <view class="me-tab-item" data-tab="tools" bindtap="handleTabTap">
      <view class="me-tab-icon me-nav-tools"></view>
      <text class="me-tab-label">工具箱</text>
    </view>
    <view class="me-tab-item" data-tab="judge" bindtap="handleTabTap">
      <view class="me-tab-icon me-nav-judge"></view>
      <text class="me-tab-label">酒桌判官</text>
    </view>
    <view class="me-tab-item me-tab-active" data-tab="me" bindtap="handleTabTap">
      <view class="me-tab-icon me-nav-me me-nav-active"></view>
      <text class="me-tab-label">我的</text>
    </view>
  </view>
</view>
