<navigation-bar title="我的" back="{{false}}" customBack="{{false}}" bind:back="handleBackTap" color="#111317" background="transparent" ext-class="pp-nav-page"></navigation-bar>
<view class="pp-page">
  <image class="pp-stage-bg" src="https://cdn.pomer.cn/static/party-pop-clean/stage-bg-390x844.png" mode="aspectFill"></image>
  <scroll-view class="pp-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="pp-hero">
      <view class="pp-brand">
        <view class="pp-avatar" bindtap="handleLoginTextTap"><image wx:if="{{loggedIn && currentProfile.avatarUrl}}" class="pp-avatar" src="{{currentProfile.avatarUrl}}" mode="aspectFill"></image><text wx:else>我</text></view>
        <view class="pp-list-copy">
          <text class="pp-kicker">MY MEMORIES</text>
          <text class="pp-title">{{loggedIn ? (currentProfile.name || '微信用户') : '点击登录'}}</text>
          <text class="pp-body">{{loggedIn ? '你的聚会记录已同步' : '登录后同步你的聚会记录和分享图'}}</text>
        </view>
      </view>
    </view>
    <view class="pp-list-item" bindtap="handleFriendHubTap">
      <image class="pp-icon-lg" src="https://cdn.pomer.cn/static/party-pop-clean/icons/service-friends.png" mode="aspectFit"></image>
      <view class="pp-list-copy"><text class="pp-list-title">合拍聚友</text><text class="pp-caption">查看一起参加过聚会的朋友，支持拍一拍和删除。</text></view>
      <text class="pp-chip">进入</text>
    </view>
    <view class="pp-tabs"><view class="pp-tab {{activeMePanel === 'overview' ? 'pp-tab-active' : ''}}" data-panel="overview" bindtap="handleMePanelTap">概览</view><view class="pp-tab {{activeMePanel === 'pending' ? 'pp-tab-active' : ''}}" data-panel="pending" bindtap="handleMePanelTap">待分享</view><view class="pp-tab {{activeMePanel === 'shares' ? 'pp-tab-active' : ''}}" data-panel="shares" bindtap="handleMePanelTap">分享图</view></view>
    <view wx:if="{{activeMePanel === 'overview'}}" class="pp-stat-row"><view wx:for="{{assetStats}}" wx:key="label" class="pp-stat" data-label="{{item.label}}" bindtap="handleAssetTap"><text class="pp-stat-value">{{item.value}}</text><text class="pp-stat-label">{{item.label}}</text></view></view>
    <view wx:if="{{activeMePanel === 'pending'}}" class="pp-panel"><view class="pp-row-between"><text class="pp-section-title">待分享回忆</text><text class="pp-chip" bindtap="handlePendingAlbumAllTap">查看全部 {{pendingAlbumTotal}}</text></view><view wx:if="{{visiblePendingAlbums.length}}" class="pp-list" style="margin-top: 14px;"><view wx:for="{{visiblePendingAlbums}}" wx:key="sessionId" class="pp-list-item" data-session-id="{{item.sessionId}}" bindtap="handlePendingAlbumTap"><image wx:if="{{item.coverUrl}}" class="pp-thumb" style="width: 78px; height: 78px;" src="{{item.coverUrl}}" mode="aspectFill"></image><image wx:else class="pp-thumb" style="width: 78px; height: 78px;" src="https://cdn.pomer.cn/static/party-pop-clean/home-hero-750x420.png" mode="aspectFill"></image><view class="pp-list-copy"><text class="pp-list-title">{{item.title}}</text><text class="pp-caption">{{item.meta}}</text></view></view></view><text wx:else class="pp-body">暂无待分享回忆</text></view>
    <view wx:if="{{activeMePanel === 'shares'}}" class="pp-panel"><view class="pp-row-between"><text class="pp-section-title">分享图合集</text><text class="pp-chip" bindtap="handleShareGalleryAllTap">查看全部 {{shareGalleryTotal}}</text></view><view wx:if="{{visibleShareImages.length}}" class="pp-list" style="margin-top: 14px;"><view wx:for="{{visibleShareImages}}" wx:key="imageUrl" class="pp-list-item" data-image-url="{{item.imageUrl}}" bindtap="handleShareGalleryTap"><image class="pp-thumb" style="width: 78px; height: 92px;" src="{{item.imageUrl}}" mode="aspectFill"></image><view class="pp-list-copy"><text class="pp-list-title">{{item.title}}</text><text class="pp-caption">{{item.meta}}</text></view></view></view><text wx:else class="pp-body">还没有生成过分享图</text></view>
  </scroll-view>
  <view wx:if="{{authPanelVisible && !loggedIn}}" class="pp-auth-mask" bindtap="closeAuthPanel">
    <form class="pp-auth-panel" catchtap="noop" bindsubmit="handleLoginSubmit">
      <view class="pp-row-between"><text class="pp-title-sm">微信授权登录</text><text class="pp-chip" bindtap="closeAuthPanel">关闭</text></view>
      <view class="pp-auth-avatar-row">
        <button class="pp-auth-avatar-frame" open-type="chooseAvatar" disabled="{{authAvatarChoosing || authSubmitting}}" bindtap="handleAuthAvatarTap" bindchooseavatar="handleAuthAvatar">
          <image wx:if="{{authAvatarUrl}}" class="pp-auth-avatar-image" src="{{authAvatarUrl}}" mode="aspectFill"></image>
          <text wx:else class="pp-auth-avatar-placeholder">头像</text>
        </button>
        <view class="pp-auth-avatar-copy">
          <text class="pp-list-title">微信头像</text>
          <text class="pp-caption">用于聚会成员、相册和分享图展示。</text>
        </view>
      </view>
      <input class="pp-input" name="nickname" type="nickname" placeholder="填写微信昵称" placeholder-class="pp-placeholder" value="{{authName}}" bindinput="handleAuthNameInput" style="margin-top: 14px;" />
      <button class="pp-button pp-button-primary" form-type="submit" loading="{{authSubmitting}}" style="width: 100%; margin-top: 14px;">确认登录</button>
    </form>
  </view>

<view class="pp-bottom-nav">
  <view class="pp-bottom-item " data-tab="home" bindtap="handleTabTap">
    <image class="pp-bottom-icon" src="https://cdn.pomer.cn/static/party-pop-clean/icons/tab-home.png" mode="aspectFit"></image>
    <text>首页</text>
  </view>
  <view class="pp-bottom-item " data-tab="tools" bindtap="handleTabTap">
    <image class="pp-bottom-icon" src="https://cdn.pomer.cn/static/party-pop-clean/icons/tab-tools.png" mode="aspectFit"></image>
    <text>工具箱</text>
  </view>
  <view class="pp-bottom-item " data-tab="rankings" bindtap="handleTabTap">
    <image class="pp-bottom-icon" src="https://cdn.pomer.cn/static/party-pop-clean/icons/tab-rank.png" mode="aspectFit"></image>
    <text>排行榜</text>
  </view>
  <view class="pp-bottom-item pp-bottom-item-active" data-tab="me" bindtap="handleTabTap">
    <image class="pp-bottom-icon" src="https://cdn.pomer.cn/static/party-pop-clean/icons/tab-me-active.png" mode="aspectFit"></image>
    <text>我的</text>
  </view>
</view>
  <pp-dialog state="{{__ppDialog}}" toast="{{__ppToast}}" loading="{{__ppLoading}}" bind:confirm="__handlePpDialogConfirm" bind:cancel="__handlePpDialogCancel"></pp-dialog>
</view>
