<navigation-bar
  title="我的"
  back="{{false}}"
  color="#24160f"
  background="rgba(255,253,248,0.96)"
  ext-class="me-nav"
></navigation-bar>

<view class="me-page">
  <scroll-view class="me-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="me-profile-row {{loggedIn ? '' : 'me-profile-auth-row'}}">
      <view wx:if="{{loggedIn}}" class="me-user">
        <image wx:if="{{currentProfile.avatarUrl}}" class="me-avatar" src="{{currentProfile.avatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="me-avatar"></view>
        <view class="me-user-copy">
          <view class="me-name-row">
            <text class="me-name">{{currentProfile.name || '微信用户'}}</text>
            <view class="me-vip-tag">V1</view>
          </view>
          <text class="me-id">已记录 {{assetStats[0].value}} 场聚会，和 {{wineStats[1].value}} 次好友回忆</text>
        </view>
      </view>

      <view wx:else class="me-login-entry" bindtap="handleLoginTextTap">
        <view class="me-login-avatar"></view>
        <text class="me-login-text">点击登录</text>
      </view>
    </view>

    <view class="me-recorder-actions">
      <view class="me-recorder-action me-recorder-action-primary" data-tab="home" bindtap="handleTabTap">
        <text>创建聚会</text>
        <text>从首页开始三步记录</text>
      </view>
      <view class="me-recorder-action" data-tab="tools" bindtap="handleTabTap">
        <text>工具箱</text>
        <text>常用聚会小工具</text>
      </view>
    </view>

    <view class="me-memory-strip">
      <view wx:for="{{assetStats}}" wx:key="label" class="me-stat-item" data-label="{{item.label}}" bindtap="handleAssetTap">
        <text class="me-stat-value">{{item.value}}</text>
        <text class="me-stat-label">{{item.label}}</text>
      </view>
    </view>

    <view wx:if="{{membershipEnabled}}" class="me-member-card">
      <view class="me-member-top">
      <text class="me-member-title">聚会记录权益</text>
        <view class="me-member-btn" bindtap="handleMemberTap">查看权益</view>
      </view>
      <text class="me-member-desc">主题、相册和分享能力直接读取后台真实配置。</text>
    </view>

    <view class="me-section-head">
      <text class="me-section-title">最近回忆</text>
      <text class="me-section-link" data-label="我的聚友" bindtap="handleWineStatTap">好友管理</text>
    </view>

    <view class="me-memory-strip">
      <view wx:for="{{wineStats}}" wx:key="label" class="me-stat-item" data-label="{{item.label}}" bindtap="handleWineStatTap">
        <text class="me-stat-value">{{item.value}}</text>
        <text class="me-stat-label">{{item.label}}</text>
      </view>
    </view>

    <view wx:if="{{momentSummaries.length}}" class="me-section-head">
      <text class="me-section-title">待分享回忆</text>
      <text class="me-section-link" bindtap="handlePendingAlbumAllTap">查看全部 {{pendingAlbumTotal}}</text>
    </view>

    <view wx:if="{{visiblePendingAlbums.length}}" class="me-pending-list">
      <view
        wx:for="{{visiblePendingAlbums}}"
        wx:key="briefId"
        class="me-pending-item"
        data-brief-id="{{item.briefId}}"
        data-session-id="{{item.sessionId}}"
        bindtap="handlePendingAlbumTap"
      >
        <view class="me-pending-dot {{item.pendingMediaCount ? 'me-pending-dot-warn' : ''}}"></view>
        <view class="me-pending-copy">
          <view class="me-pending-title-row">
            <text class="me-pending-title">{{item.title}}</text>
          </view>
          <text class="me-pending-meta">{{item.meta}}</text>
        </view>
        <view class="me-pending-action-stack">
          <text wx:if="{{item.isEnded}}" class="me-pending-state me-pending-state-ended">{{item.stateLabel}}</text>
          <text wx:elif="{{item.stateLabel}}" class="me-pending-state">{{item.stateLabel}}</text>
          <view class="me-pending-action {{item.isEnded ? 'me-pending-action-muted' : ''}}">{{item.actionLabel}}</view>
        </view>
      </view>
      <view class="me-pending-more" bindtap="handlePendingAlbumAllTap">
        查看全部待分享回忆
      </view>
    </view>

    <view class="me-section-head">
      <text class="me-section-title">更多设置</text>
    </view>

    <view class="me-grid">
      <view wx:for="{{features}}" wx:key="id" class="me-tile" data-name="{{item.name}}" bindtap="handleFeatureTap">
        <view class="me-tile-icon">
          <view class="me-tile-glyph {{item.iconClass}}"></view>
        </view>
        <text class="me-tile-label">{{item.name}}</text>
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{authPanelVisible && !loggedIn}}" class="auth-panel-mask" bindtap="closeAuthPanel">
    <form class="auth-panel" catchtap="noop" bindsubmit="handleLoginSubmit">
      <view class="auth-panel-head">
        <text class="auth-panel-title">微信授权登录</text>
        <text class="auth-panel-close" bindtap="closeAuthPanel">关闭</text>
      </view>
      <view class="auth-avatar-row">
        <button
          class="auth-avatar-btn"
          open-type="chooseAvatar"
          disabled="{{authAvatarChoosing || authSubmitting}}"
          bindtap="handleAuthAvatarTap"
          bindchooseavatar="handleAuthAvatar"
        >
          <image wx:if="{{authAvatarUrl}}" class="auth-avatar" src="{{authAvatarUrl}}" mode="aspectFill"></image>
          <view wx:else class="auth-avatar"></view>
        </button>
        <view class="auth-avatar-copy">
          <text class="auth-avatar-title">点击头像授权</text>
          <text class="auth-avatar-desc">用于聚会成员展示，不会使用默认图片占位。</text>
        </view>
      </view>
        <input
          class="auth-name-input"
          name="nickname"
          type="nickname"
          placeholder="填写微信昵称"
          value="{{authName}}"
          bindinput="handleAuthNameInput"
        />
      <button class="auth-submit" form-type="submit" loading="{{authSubmitting}}">确认登录</button>
    </form>
  </view>

  <view class="bottom-nav">
    <view class="bottom-item" data-tab="home" bindtap="handleTabTap">
      <view class="bottom-icon nav-home"></view>
      <text class="bottom-label">首页</text>
    </view>
    <view class="bottom-item" data-tab="tools" bindtap="handleTabTap">
      <view class="bottom-icon nav-judge"></view>
      <text class="bottom-label">工具箱</text>
    </view>
    <view class="bottom-item active" data-tab="me" bindtap="handleTabTap">
      <view class="bottom-icon nav-me active"></view>
      <text class="bottom-label">我的</text>
    </view>
  </view>
</view>
